/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included by main.asc — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * P2/P3 vertical-slice milestones (parent plan P2, 2026-09-05; P3 decision 2026-09-06):
 *   P2a [done]: fp16 Vector dot slice; cloud verdict 2026-09-05 — the Cube engine
 *     cannot execute a 1x1 tile (GetTiling OK but run dies ret=507015).
 *   P2b [done]: real M/N (B=1, M=N=K=64) via Cube -> temp C GM -> bmm_reduce.
 *     Cloud verdicts: ASCENDC_CUBE_ONLY (see #define below) fixed a ret=507015 of
 *     the pure __cube__ kernel; a numeric mismatch was a reduce DIRECTION bug
 *     (correct order is first-max-over-N then sum-over-M; fixed).
 *   P3 [this file, 2026-09-06]: full-shape domain. ROUTE DECISION (route ③,
 *     "bounded-C dual kernel") after two cloud rounds proved the fused __mix__(1,2)
 *     kernel dies ret=507015 even without the kernel-top guard — the host was
 *     feeding a SetDim(1)/usedCores==1 tiling to a __mix__(1,2) launch while the
 *     official 03.05 mix sample uses SetDim(2) + CalcOffset(GetBlockIdx()) so both
 *     AIVs get tile plans. Route ③ abandons the fused VECIN/GetTensorC form for
 *     now (that optimization is deferred to P4) and instead re-uses the P2b-proven
 *     dual-kernel pipeline with a BOUNDED C intermediate:
 *       1. data files are zero-padded by gen_data.py: K -> Kpad (next multiple of
 *          16) and M -> Mpad (next multiple of 64). Cube then only ever runs
 *          16-aligned shapes; the zero rows/cols contribute exactly 0.
 *       2. per batch, host walks M in 64-row blocks, launching one __cube__
 *          bmm_batch_cube (shape 64 x N x Kpad) whose C tile goes to a small GM
 *          buffer (64*N*4B, <=2MB at N=8192) and then one __vector__
 *          bmm_block_reduce that contracts that tile to a single partial sum
 *          (partSum[block]). After the last block bmm_part_sum adds the partials
 *          into y[b]. The full B x M x N x 4B C intermediate never exists
 *          (~17GB at B=64 M=N=8192 K=32 under the P2b whole-batch scheme).
 *       3. M==N==1 keeps the P2a vector dot fallback. N%8!=0 (non-single-point)
 *          is an honest boundary for this slice (the row reads below need every
 *          segment length *4B to be a 32B multiple of the cube C tile).
 *     Design/verdict record: .codebuddy/plans/P3_fullshape_fused_reduce_arch.md.
 *
 * Reference notes (local docs, cross-checked):
 *   - fp16 cube skeleton:     ascendc_operator_development_light/03_simple_operator_practice/answer/03.03/matmul_custom.asc
 *   - fused (deferred):       .../answer/03.05/matmul_abs.asc + 05.04 matmul_abs.cpp
 */

#include <cstdint>
#include <cstdio>
#include <cfloat>

#include "acl/acl.h"
#include "kernel_operator.h"
// 2026-09-06 route ③: P2b PROVED ASCENDC_CUBE_ONLY (defined right before
// lib/matmul_intf.h) fixes the ret=507015 of the PURE __cube__ kernel on 910B:
// under SPLIT_CORE_CUBE, kfc_register_obj.h expands REGIST_MATMUL_OBJ to a
// KfcServer loop unless this macro flips it to InitCurObj. Route ③ contains NO
// __mix__ kernel anymore (the fused form died 507015 under SetDim(1), see the
// P3 route note above), so defining it is mandatory again.
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

namespace {

// Host-side pad helpers. They live in kernel.asc (included by main.asc) so the
// device-facing buffer layout (byte sizes, batch strides) is computed from the
// SAME formulas in main.asc, run_kernel and scripts/gen_data.py.
// Kpad pads the matmul-K to a multiple of 16 (fp16 L1/C0 granularity); Mpad pads
// the x1 row count to a multiple of 64 (the bounded-C M-block size). Pad rows /
// columns are guaranteed ZERO by gen_data.py, so every padded element contributes
// exactly 0 to the fp32 dot product.
inline int64_t kPadM(int64_t m)
{
    const int64_t r = m % 64;
    return (r == 0) ? m : (m + (64 - r));
}
inline int64_t kPadK(int64_t k)
{
    const int64_t r = k % 16;
    return (r == 0) ? k : (k + (16 - r));
}
// Number of 64-row M blocks over the padded row count.
inline int64_t kMBlocks(int64_t m) { return kPadM(m) / 64; }

struct FixSplitProbe {
    const char* name;  // log tag of the candidate
    bool useFix;       // false -> SetFixSplit() is not called at all
    int32_t baseM;
    int32_t baseN;
};

bool ProbeDup(const FixSplitProbe* ladder, int32_t len, const FixSplitProbe& cand)
{
    for (int32_t i = 0; i < len; ++i) {
        if (!ladder[i].useFix) {
            if (!cand.useFix) return true;  // only one "no SetFixSplit" probe
            continue;
        }
        if (cand.useFix && ladder[i].baseM == cand.baseM && ladder[i].baseN == cand.baseN) return true;
    }
    return false;
}

void PushProbe(FixSplitProbe* ladder, int32_t* len, const FixSplitProbe& cand)
{
    if (ProbeDup(ladder, *len, cand)) return;
    ladder[(*len)++] = cand;
}

// Deterministic probe ladder for matmul_tiling::SetFixSplit(). v0 is the
// official tutorial default (128, 128); v1..v5 are relaxed/adaptive probes.
// Every probe gets a FRESH MultiCoreMatmulTiling (the object is single-use) and
// all other options stay byte-for-byte identical to the official tutorial; the
// first probe that yields a valid TCubeTiling wins. P2a/P2b used the same ladder.
// Route ③ calls this once per run with shape (64, N, Kpad): one 64-row M block of
// one batch. The block's x1 slice (64*Kpad halves) is passed per launch, so the
// tiling must give usedCoreNum==1 and singleCore == (64, N).
bool GenBatchMatmulTiling(platform_ascendc::PlatformAscendC* platform, AscendC::tiling::TCubeTiling& tiling,
                          int32_t m, int32_t n, int32_t k)
{
    const int32_t adM = (m < 128) ? m : 128;  // adaptive base = shape capped at the official default
    const int32_t adN = (n < 128) ? n : 128;

    constexpr int32_t kMaxProbes = 8;
    FixSplitProbe ladder[kMaxProbes];
    int32_t ladderLen = 0;

    PushProbe(ladder, &ladderLen, {"v0 official SetFixSplit(128,128)", true, 128, 128});
    PushProbe(ladder, &ladderLen, {"v1 no SetFixSplit", false, 0, 0});
    PushProbe(ladder, &ladderLen, {"v2 adaptive SetFixSplit(min(shape,128))", true, adM, adN});
    PushProbe(ladder, &ladderLen, {"v3 SetFixSplit(16,16)", true, 16, 16});
    PushProbe(ladder, &ladderLen, {"v4 SetFixSplit(8,8)", true, 8, 8});
    PushProbe(ladder, &ladderLen, {"v5 SetFixSplit(1,1)", true, 1, 1});

    for (int32_t p = 0; p < ladderLen; ++p) {
        const FixSplitProbe& pr = ladder[p];
        matmul_tiling::MultiCoreMatmulTiling cubeTiling(*platform);
        cubeTiling.SetDim(1);  // one cube core computes the whole 64 x N block
        cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT);
        cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                               matmul_tiling::DataType::DT_FLOAT);
        cubeTiling.SetShape(m, n, k);
        cubeTiling.SetOrgShape(m, n, k);
        if (pr.useFix) {
            cubeTiling.SetFixSplit(pr.baseM, pr.baseN, -1);
        }
        cubeTiling.SetBias(true);
        cubeTiling.SetBufferSpace(-1, -1, -1);
        if (cubeTiling.GetTiling(tiling) == -1) {
            if (pr.useFix) {
                std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): FAILED\n", pr.name, pr.baseM, pr.baseN);
            } else {
                std::fprintf(stderr, "[bmm] tiling probe %s: FAILED\n", pr.name);
            }
            continue;
        }
        if (pr.useFix) {
            std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): OK\n", pr.name, pr.baseM, pr.baseN);
        } else {
            std::fprintf(stderr, "[bmm] tiling probe %s: OK\n", pr.name);
        }
        // 507015 diagnosis dump (2026-09-06): M/N/Ka/Kb drive the GM-buffer views
        // in bmm_batch_cube, singleCore*/base* reflect the actual cube tile the
        // tiling library picked.
        std::fprintf(stderr,
            "[bmm] probe %s tiling dump: M=%d N=%d Ka=%d Kb=%d singleCore(M=%d,N=%d,K=%d) "
            "base(M=%d,N=%d,K=%d) usedCores=%d isBias=%d\n",
            pr.name, tiling.M, tiling.N, tiling.Ka, tiling.Kb, tiling.singleCoreM,
            tiling.singleCoreN, tiling.singleCoreK, tiling.baseM, tiling.baseN, tiling.baseK,
            tiling.usedCoreNum, tiling.isBias);
        return true;
    }

    std::fprintf(stderr, "[bmm] GenMatmulTiling failed for M=%d N=%d K=%d after %d probe(s)\n", m, n, k, ladderLen);
    return false;
}

}  // namespace

// Cube MatMul for ONE 64-row M block of one batch:
//     C[0:64*N] = x1Block(0:64 x Kpad) x x2(0:Kpad x N), fp16 x fp16 -> fp32
// with an all-zero bias (N floats) added. Mirrors tutorial 03.03 line for line
// (audit in P2b, branch fix/p2b-cube-real-shape — 507015 fixed by ASCENDC_CUBE_ONLY,
// see top-of-file note). launched <<<1>>> per (batch, block); the tiling shape is
// (64, N, Kpad) and the caller passes this block's x1 slice pointer (a full 64
// rows may include the zero-padded tail rows of Mpad when this is the last block
// of the padded row count).
__global__ __cube__ void bmm_batch_cube(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias,
                                        __gm__ uint8_t* c, __gm__ uint8_t* workspace,
                                        AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    AscendC::GlobalTensor<float> cGlobal;

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);
    mm.IterateAll(cGlobal);
    mm.End();
}

// Vector dot-product fallback for M == N == 1 (kept from P2a/P2b). Launched as
// <<<1>>> by run_kernel for every single-point batch because the Cube engine
// cannot execute a 1x1 tile (2026-09-05 cloud evidence).
//
// Data files are the padded layout produced by gen_data.py / main.asc: per batch
// b, x1 owns a bStrideA = Mpad*Kpad half-slot whose first Kpad halves (row 0) hold
// x1[b,0,:] followed by zero pad; x2 owns a bStrideB = Kpad*N half-slot whose
// first Kpad*N halves hold x2[b,:,:] (N==1, so column 0 is contiguous Kpad rows).
// The kernel sums over Kpad halves per batch: the zero-padded tail contributes
// exactly 0, so this is numerically the single-point product of the real K.
//
// K is consumed in chunks of at most KCH (64) halves; each chunk is cast/mul/
// reduced to one fp32 chunk sum and folded into outLocal[0] with a 1-element Add.
__global__ __vector__ void bmm_batch_dot(__gm__ uint8_t* aIn, __gm__ uint8_t* bIn, __gm__ uint8_t* yOut,
                                         int32_t bCount, int32_t k, int32_t aStride, int32_t bStride)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    // One chunk = one 910B vector repeat: 64 fp32 lanes for cast/mul/reduce.
    constexpr int32_t KCH = 64;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQA;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastA;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastB;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufProd;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQA, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(inQB, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(outQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastA, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastB, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufProd, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, 8 * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> castA = bufCastA.Get<float>();
    LocalTensor<float> castB = bufCastB.Get<float>();
    LocalTensor<float> prod = bufProd.Get<float>();
    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    for (int32_t bIdx = 0; bIdx < bCount; ++bIdx) {
        const int32_t aBatchBase = bIdx * aStride;  // half elements to row 0 of batch b
        const int32_t bBatchBase = bIdx * bStride;

        // Accumulator lives in the copy-out queue so its EnQue/DeQue hands the
        // V -> MTE3 ordering to the 4-byte DataCopyPad below.
        LocalTensor<float> outLocal = outQ.AllocTensor<float>();
        AscendC::Duplicate(outLocal, static_cast<float>(0), KCH);

        int32_t kLeft = k;
        int32_t kOff = 0;
        while (kLeft > 0) {
            const int32_t cnt = (kLeft < KCH) ? kLeft : KCH;

            LocalTensor<half> aLocal = inQA.AllocTensor<half>();
            LocalTensor<half> bLocal = inQB.AllocTensor<half>();

            __gm__ half* aSegPtr = reinterpret_cast<__gm__ half*>(aIn) + (aBatchBase + kOff);
            __gm__ half* bSegPtr = reinterpret_cast<__gm__ half*>(bIn) + (bBatchBase + kOff);
            AscendC::GlobalTensor<half> aSeg;
            AscendC::GlobalTensor<half> bSeg;
            aSeg.SetGlobalBuffer(aSegPtr, cnt);
            bSeg.SetGlobalBuffer(bSegPtr, cnt);

            AscendC::DataCopy(aLocal, aSeg, cnt);
            AscendC::DataCopy(bLocal, bSeg, cnt);
            inQA.EnQue(aLocal);
            inQB.EnQue(bLocal);

            aLocal = inQA.DeQue<half>();
            bLocal = inQB.DeQue<half>();

            AscendC::Cast(castA, aLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Cast(castB, bLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Mul(prod, castA, castB, cnt);
            AscendC::ReduceSum<float, true>(part, prod, tmp, cnt);  // chunk sum -> part[0]
            AscendC::Add(outLocal, outLocal, part, 1);              // outLocal[0] += part[0]

            inQA.FreeTensor(aLocal);
            inQB.FreeTensor(bLocal);

            kOff += cnt;
            kLeft -= cnt;
        }

        outQ.EnQue(outLocal);
        outLocal = outQ.DeQue<float>();

        __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(yOut) + bIdx;
        AscendC::GlobalTensor<float> ySeg;
        ySeg.SetGlobalBuffer(yPtr, 1);
        AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
        AscendC::DataCopyPad(ySeg, outLocal, outParams);
        outQ.FreeTensor(outLocal);
    }
}

// Bounded-C vector reduction over ONE cube C tile (a 64-row block of one batch):
//     partial = sum over the REAL rows r < mRows of max over the row's N entries
//             = sum_{r<mRows} max_{c<N} tile[r*N + c]
// The caller passes mRows == number of real rows in this block (block rows are
// always 64; only the final M-block of a batch can have mRows < 64 when M%64!=0,
// and the zero-padded rows beyond M are simply never counted). The partial is a
// single fp32 stored into partOut via the exact 4-byte DataCopyPad store.
//
// Row length N can be any multiple of 8 (run_kernel boundary): every chunk below
// starts at float offset (r*N + c0) with N%8==0 and c0%64==0, so every DataCopy
// segment is 32B-aligned and its length (<=64, N%64 remainder also %8==0) is a
// 32B multiple — no scalar reads, no DataCopyPad reads needed. N%64 == 0 means
// every segment is 64 floats (256B).
//
// CANN 9.0.0 / 910B (2201) API facts (verified 2026-09-06 against the packaged
// headers; reuse of the P2b bmm_reduce audit):
//   * ReduceMax Level-2 count version: ReduceMax(dst, src, sharedTmpBuffer,
//     count, calIndex = 0); on 2201 it is a single-repeat whole-reduce, fp32
//     elementNumPerRep = 64, so count <= 64 (any remainder works; P2a proved
//     sub-64 whole-reduces are masked to count lanes).
//   * Max(dst, src0, src1, count)/Add(dst, src0, src1, count) elementwise
//     count-mode at element offset 0 (P2b proved Add(acc,acc,part,1)).
__global__ __vector__ void bmm_block_reduce(__gm__ uint8_t* cIn, __gm__ uint8_t* partOut, int32_t mRows,
                                            int32_t n)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    constexpr int32_t KCH = 64;  // fp32 lanes per vector repeat

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;    // 64-float row chunk slot
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;  // acc[0] accumulator slot
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufRowMax;

    pipe.InitBuffer(inQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufRowMax, KCH * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();
    LocalTensor<float> rowMax = bufRowMax.Get<float>();

    // acc[0] accumulates the SUM over the mRows row maxima.
    LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, static_cast<float>(0), KCH);  // acc[0] = 0.0f

    __gm__ float* cBase = reinterpret_cast<__gm__ float*>(cIn);
    for (int32_t r = 0; r < mRows; ++r) {
        // rowMax[0] = -FLT_MAX identity: a fully-negative row must return its
        // largest negative value, NOT 0 (problem constraint, no zero init).
        AscendC::Duplicate(rowMax, static_cast<float>(-3.4028234663852886e+38), KCH);
        const int32_t rowOff = r * n;
        int32_t col = 0;
        while (col < n) {
            const int32_t seg = (n - col < KCH) ? (n - col) : KCH;  // %8==0 always (n%8==0)

            LocalTensor<float> chunk = inQ.AllocTensor<float>();
            __gm__ float* segPtr = cBase + rowOff + col;
            AscendC::GlobalTensor<float> segG;
            segG.SetGlobalBuffer(segPtr, seg);
            AscendC::DataCopy(chunk, segG, seg);
            inQ.EnQue(chunk);

            chunk = inQ.DeQue<float>();
            AscendC::ReduceMax(part, chunk, tmp, seg);   // part[0] = max over this segment
            AscendC::Max(rowMax, rowMax, part, 1);       // rowMax[0] = max(rowMax[0], part[0])
            inQ.FreeTensor(chunk);

            col += seg;
        }
        AscendC::Add(acc, acc, rowMax, 1);               // acc[0] += row max
    }

    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();

    __gm__ float* partPtr = reinterpret_cast<__gm__ float*>(partOut);
    AscendC::GlobalTensor<float> partSeg;
    partSeg.SetGlobalBuffer(partPtr, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(partSeg, acc, outParams);
    outQ.FreeTensor(acc);
}

// Sums count fp32 values from GM partIn into one fp32 written to yOut (the batch
// y[b] slot). count is the PADDED per-batch partial count = ceil(blocks/8)*8, so
// count is always a multiple of 8 and the partIn buffer is pre-zeroed past the
// real partials (which contribute exactly 0). count <= 128 for M<=8192.
__global__ __vector__ void bmm_part_sum(__gm__ uint8_t* partIn, __gm__ uint8_t* yOut, int32_t count)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    constexpr int32_t KCH = 64;  // fp32 lanes per whole-reduce repeat

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, KCH * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, static_cast<float>(0), KCH);  // acc[0] = 0.0f

    __gm__ float* inBase = reinterpret_cast<__gm__ float*>(partIn);
    int32_t off = 0;
    while (off < count) {
        const int32_t seg = (count - off < KCH) ? (count - off) : KCH;  // %8==0 (count%8==0)

        LocalTensor<float> chunk = inQ.AllocTensor<float>();
        AscendC::GlobalTensor<float> segG;
        segG.SetGlobalBuffer(inBase + off, seg);
        AscendC::DataCopy(chunk, segG, seg);
        inQ.EnQue(chunk);

        chunk = inQ.DeQue<float>();
        AscendC::ReduceSum<float, true>(part, chunk, tmp, seg);  // chunk sum -> part[0]
        AscendC::Add(acc, acc, part, 1);                          // acc[0] += part[0]
        inQ.FreeTensor(chunk);

        off += seg;
    }

    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();

    __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(yOut);
    AscendC::GlobalTensor<float> ySeg;
    ySeg.SetGlobalBuffer(yPtr, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(ySeg, acc, outParams);
    outQ.FreeTensor(acc);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    (void)availableCoreNum;

    // --- P3 scope guards (honest boundaries) ---
    if (info_x1.numTensors < 1 || info_x2.numTensors < 1 || info_y.numTensors < 1) {
        std::fprintf(stderr, "[bmm] P3 expects one tensor per input/output group\n");
        return;
    }
    const TensorInfo& t1 = info_x1.tensors[0];
    const TensorInfo& t2 = info_x2.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    if (t1.numDims != 3 || t2.numDims != 3 || ty.numDims != 1) {
        std::fprintf(stderr, "[bmm] P3 expects x1/x2 rank-3 and y rank-1\n");
        return;
    }
    if (t1.dtype != 1 || t2.dtype != 1) {  // fp16 inputs only (this slice); bf16 later
        std::fprintf(stderr, "[bmm] P3 supports fp16 inputs only (got x1=%d x2=%d)\n", t1.dtype, t2.dtype);
        return;
    }
    if (ty.dtype != 0) {  // y must be fp32
        std::fprintf(stderr, "[bmm] P3 expects fp32 output (got y=%d)\n", ty.dtype);
        return;
    }
    if (transposeX1 || transposeX2) {
        std::fprintf(stderr, "[bmm] P3 supports transposeX1/transposeX2 == false only\n");
        return;
    }

    const int64_t B = t1.shape[0];
    const int64_t M = t1.shape[1];
    const int64_t K1 = t1.shape[2];
    const int64_t K2 = t2.shape[1];
    const int64_t N = t2.shape[2];
    if (t2.shape[0] != B || K1 != K2 || ty.shape[0] != B) {
        std::fprintf(stderr, "[bmm] inconsistent shapes: x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) y=(%lld)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)t2.shape[0], (long long)K2,
                     (long long)N, (long long)ty.shape[0]);
        return;
    }
    const bool singlePoint = (M == 1 && N == 1);
    constexpr int64_t kP3MaxB = 64;
    constexpr int64_t kP3MaxDim = 8192;
    constexpr int64_t kP3MinK = 32;
    constexpr int64_t kP3MaxK = 8192;
    if (B > kP3MaxB || M > kP3MaxDim || N > kP3MaxDim || K1 < kP3MinK || K1 > kP3MaxK || (K1 % 8) != 0) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: outside statement domain x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) "
                     "(B<=%lld M,N<=%lld K in [%lld,%lld] mult of 8)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)B, (long long)K2, (long long)N,
                     (long long)kP3MaxB, (long long)kP3MaxDim, (long long)kP3MinK, (long long)kP3MaxK);
        return;
    }
    // Route-③ honest boundary for this slice: the block_reduce row reads need
    // every segment (<=64 floats, remainder of N/64) to be a 32B multiple. That
    // holds exactly when N%8==0 (segment length floats %8==0 and every row start
    // offset N floats %8==0). The single-point dot path has no such constraint.
    if (!singlePoint && (N % 8) != 0) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: bounded-C path needs N %% 8 == 0 (got N=%lld); "
                     "non-8-multiple N is a later slice\n",
                     (long long)N);
        return;
    }

    // x1/x2/y are GM_ADDR = __gm__ uint8_t*. Keep the qualifier end-to-end.
    __gm__ uint8_t* x1Base = x1;
    __gm__ uint8_t* x2Base = x2;
    __gm__ uint8_t* yBase = y;

    // Padded layout (gen_data.py / main.asc MUST match):
    //   x1: (B, Mpad, Kpad) halves — Mpad = ceil(M/64)*64 rows (last rows zero),
    //       each row Kpad = next multiple of 16 (row K..Kpad-1 halves zero).
    //   x2: (B, Kpad, N) halves — row K..Kpad-1 zero.
    const int64_t Mpad = kPadM(M);
    const int64_t Kpad = kPadK(K1);
    const int64_t blocks = kMBlocks(M);  // 64-row blocks over Mpad
    const int64_t partPad = ((blocks + 7) / 8) * 8;  // padded partial count (mult of 8)

    if (singlePoint) {
        // M == N == 1: the Cube engine cannot execute a 1x1 tile (2026-09-05
        // cloud verdict), so route to the vector dot kernel. x1's real row 0 sits
        // at batch base + 0; the zero Kpad pad contributes nothing.
        std::fprintf(stderr, "[bmm] run path: VECTOR DOT FALLBACK (1x1: B=%lld Kpad=%lld Mpad=%lld)\n",
                     (long long)B, (long long)Kpad, (long long)Mpad);
        bmm_batch_dot<<<1, nullptr, stream>>>(x1Base, x2Base, yBase, static_cast<int32_t>(B),
                                              static_cast<int32_t>(Kpad),
                                              static_cast<int32_t>(Mpad * Kpad),
                                              static_cast<int32_t>(Kpad * N));
        return;
    }

    // ===== Route ③: bounded-C dual-kernel pipeline =====
    // One __cube__ bmm_batch_cube per (batch, 64-row block) writes its 64xN C
    // tile to a small scratch buffer; one __vector__ bmm_block_reduce contracts
    // the tile to partSum[block]. After the batch's last block bmm_part_sum adds
    // the block partials into y[b]. C is bounded to 64*N*4B (<=2MB at N=8192)
    // and only B fp32 y[b] values ever leave the device permanently.
    platform_ascendc::PlatformAscendC* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        std::fprintf(stderr, "[bmm] PlatformAscendCManager::GetInstance() returned nullptr\n");
        return;
    }

    // One tiling for every 64-row block (blocks share the same shape 64xNxKpad).
    AscendC::tiling::TCubeTiling tiling;
    if (!GenBatchMatmulTiling(platform, tiling, 64, static_cast<int32_t>(N), static_cast<int32_t>(Kpad))) {
        return;
    }
    // The per-launch cube kernel computes the WHOLE 64xN block from the slice
    // pointer it is given, so a core-splitting tiling is an honest boundary.
    // Ka/Kb must equal Kpad because the cube kernel treats the GM A/B buffers as
    // contiguous row-major with row length Ka/Kb; the padded x1 rows are exactly
    // Kpad wide, so Ka==Kb==Kpad is required for the reads to line up.
    if (tiling.Ka != static_cast<int32_t>(Kpad) || tiling.Kb != static_cast<int32_t>(Kpad)) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: tiling K view Ka=%d Kb=%d != Kpad=%lld; "
                     "padded-buffer row width mismatch, abort\n",
                     tiling.Ka, tiling.Kb, (long long)Kpad);
        return;
    }
    if (tiling.usedCoreNum != 1 || tiling.singleCoreM != tiling.M || tiling.singleCoreN != tiling.N ||
        tiling.singleCoreK != tiling.Ka) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: tiling splits the 64xN block (usedCoreNum=%d singleCore=(%d,%d,%d) "
                     "shape=(%d,%d,%d)); bounded-C path needs usedCoreNum==1 + whole block\n",
                     tiling.usedCoreNum, tiling.singleCoreM, tiling.singleCoreN, tiling.singleCoreK, tiling.M,
                     tiling.N, tiling.Ka);
        return;
    }

    std::fprintf(stderr,
                 "[bmm] run path: BOUNDED-C DUAL KERNEL (B=%lld M=%lld N=%lld K=%lld -> Mpad=%lld Kpad=%lld "
                 "blocks=%lld partPad=%lld base=(%d,%d))\n",
                 (long long)B, (long long)M, (long long)N, (long long)K1, (long long)Mpad, (long long)Kpad,
                 (long long)blocks, (long long)partPad, tiling.baseM, tiling.baseN);

    const int64_t wsBytes = static_cast<int64_t>(platform->GetLibApiWorkSpaceSize());
    const int64_t biasBytes = N * static_cast<int64_t>(sizeof(float));
    const int64_t cTileBytes = 64 * N * static_cast<int64_t>(sizeof(float));  // 64 x N fp32
    const int64_t partBytes = B * partPad * static_cast<int64_t>(sizeof(float));

    uint8_t* biasDevice = nullptr;
    uint8_t* wsDevice = nullptr;
    uint8_t* cTileDevice = nullptr;
    uint8_t* partDevice = nullptr;
    auto aclErr = aclrtMalloc(reinterpret_cast<void**>(&biasDevice), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&cTileDevice), cTileBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS && wsBytes > 0) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&wsDevice), wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&partDevice), partBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMalloc failed ret=%d\n", aclErr);
        if (biasDevice != nullptr) aclrtFree(biasDevice);
        if (cTileDevice != nullptr) aclrtFree(cTileDevice);
        if (wsDevice != nullptr) aclrtFree(wsDevice);
        if (partDevice != nullptr) aclrtFree(partDevice);
        return;
    }

    // bias is all zeros so C = pure batch matmul. partDevice is zeroed once so the
    // per-batch padded partial slots beyond the real block count contribute 0.
    if (aclrtMemsetAsync(biasDevice, biasBytes, 0, biasBytes, stream) != ACL_SUCCESS ||
        aclrtMemsetAsync(partDevice, partBytes, 0, partBytes, stream) != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMemsetAsync failed\n");
        aclrtFree(biasDevice);
        aclrtFree(cTileDevice);
        aclrtFree(wsDevice);
        aclrtFree(partDevice);
        return;
    }

    const int64_t x1BatchStrideHalf = Mpad * Kpad;    // halves
    const int64_t x2BatchStrideHalf = Kpad * N;       // halves
    const int64_t blockStrideHalf = 64 * Kpad;        // halves per 64-row block

    for (int64_t b = 0; b < B; ++b) {
        __gm__ uint8_t* aBatch = x1Base + b * x1BatchStrideHalf * static_cast<int64_t>(sizeof(uint16_t));
        __gm__ uint8_t* bBatch = x2Base + b * x2BatchStrideHalf * static_cast<int64_t>(sizeof(uint16_t));
        __gm__ uint8_t* ySlot = yBase + b * static_cast<int64_t>(sizeof(float));
        __gm__ uint8_t* partBase =
            partDevice + b * partPad * static_cast<int64_t>(sizeof(float));

        for (int64_t blk = 0; blk < blocks; ++blk) {
            // Real rows of this block: full 64 except the final block when M%64!=0.
            int64_t realRows = M - blk * 64;
            if (realRows > 64) {
                realRows = 64;
            }
            __gm__ uint8_t* aBlock = aBatch + blk * blockStrideHalf * static_cast<int64_t>(sizeof(uint16_t));
            bmm_batch_cube<<<1, nullptr, stream>>>(aBlock, bBatch, biasDevice, cTileDevice, wsDevice, tiling);
            bmm_block_reduce<<<1, nullptr, stream>>>(cTileDevice, partBase + blk * sizeof(float),
                                                     static_cast<int32_t>(realRows), static_cast<int32_t>(N));
        }
        bmm_part_sum<<<1, nullptr, stream>>>(partBase, ySlot, static_cast<int32_t>(partPad));
    }

    // Every launch above is async on `stream`; the device still reads the
    // scratch buffers until the stream drains. P2b got the ordering implicitly
    // from its synchronous D2H diagnostic memcpy; route③ has no such dump, so
    // sync EXPLICITLY before freeing (otherwise free-then-use races the queued
    // kernels -> stale C / 507015-class failures).
    aclrtSynchronizeStream(stream);

    aclrtFree(biasDevice);
    aclrtFree(cTileDevice);
    if (wsDevice != nullptr) aclrtFree(wsDevice);
    aclrtFree(partDevice);
}

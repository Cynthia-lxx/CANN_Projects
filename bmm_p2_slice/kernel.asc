/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included by main.asc — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * P2 vertical-slice milestone plan (parent plan P2, 2026-09-05):
 *   P2a [this file]: fp16 Vector dot-product slice (case0-only route).
 *     Cloud verdict 2026-09-05 (run.sh on the 910B CANN Lab): the Cube path
 *     (bmm_batch_cube <<<1>>> + MultiCoreMatmulTiling ladder) is NOT usable for
 *     a 1x1 tile: the ladder accepts the no-SetFixSplit probe for (1,1,32)
 *     (v0 fixed (128,128) FAILED, v1 no SetFixSplit OK), but the resulting Cube
 *     run then dies with "aclrtSynchronizeStreamWithTimeout failed, ret=507015"
 *     — GetTiling() success does NOT imply the Cube engine can execute 1x1.
 *     Therefore, under the P2a M == N == 1 guard, case0 is ALWAYS routed to
 *     bmm_batch_dot (__vector__, per-<=64-element-chunk fp32-accumulated dot
 *     products, exact 4-byte DataCopyPad store per batch). The Cube ladder/path
 *     remains in this file as unreachable P2b scaffolding for real M/N shapes.
 *     Numerically EXACT only for M == N == 1 (template case0); any other shape
 *     prints an error and returns until the P2b reduction kernel lands.
 *   P2b [next]: dedicated Vector reduction kernel over C in GM, generic M/N.
 *
 * Reference notes (local docs, cross-checked):
 *   - fp16 cube skeleton:     ascendc_operator_development_light/03_simple_operator_practice/answer/03.03/matmul_custom.asc
 *   - cube+vector mix kernel: .../answer/03.05/matmul_abs.asc  (__mix__(1,2), __kfc_workspace__)
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

namespace {

struct FixSplitProbe {
    const char* name;  // log tag of the candidate
    bool useFix;       // false -> SetFixSplit() is not called at all
    int32_t baseM;
    int32_t baseN;
};

bool ProbeDup(const FixSplitProbe* ladder, int32_t len, const FixSplitProbe& cand)
{
    for (int32_t i = 0; i < len; ++i) {
        if (!ladder[i].useFix) {
            if (!cand.useFix) return true;  // only one "no SetFixSplit" probe
            continue;
        }
        if (cand.useFix && ladder[i].baseM == cand.baseM && ladder[i].baseN == cand.baseN) return true;
    }
    return false;
}

void PushProbe(FixSplitProbe* ladder, int32_t* len, const FixSplitProbe& cand)
{
    if (ProbeDup(ladder, *len, cand)) return;
    ladder[(*len)++] = cand;
}

// Deterministic probe ladder for matmul_tiling::SetFixSplit(). v0 is the
// official tutorial default (128, 128); v1..v5 are relaxed/adaptive probes.
// Every probe gets a FRESH MultiCoreMatmulTiling (the object is single-use) and
// all other options stay byte-for-byte identical to the official tutorial; the
// first probe that yields a valid TCubeTiling wins. This tells us empirically
// (cloud log) whether M == N == 1 is rejected only because of the fixed split.
bool GenBatchMatmulTiling(platform_ascendc::PlatformAscendC* platform, AscendC::tiling::TCubeTiling& tiling,
                          int32_t m, int32_t n, int32_t k)
{
    const int32_t adM = (m < 128) ? m : 128;  // adaptive base = shape capped at the official default
    const int32_t adN = (n < 128) ? n : 128;

    constexpr int32_t kMaxProbes = 8;
    FixSplitProbe ladder[kMaxProbes];
    int32_t ladderLen = 0;

    PushProbe(ladder, &ladderLen, {"v0 official SetFixSplit(128,128)", true, 128, 128});
    PushProbe(ladder, &ladderLen, {"v1 no SetFixSplit", false, 0, 0});
    PushProbe(ladder, &ladderLen, {"v2 adaptive SetFixSplit(min(shape,128))", true, adM, adN});
    PushProbe(ladder, &ladderLen, {"v3 SetFixSplit(16,16)", true, 16, 16});
    PushProbe(ladder, &ladderLen, {"v4 SetFixSplit(8,8)", true, 8, 8});
    PushProbe(ladder, &ladderLen, {"v5 SetFixSplit(1,1)", true, 1, 1});

    for (int32_t p = 0; p < ladderLen; ++p) {
        const FixSplitProbe& pr = ladder[p];
        matmul_tiling::MultiCoreMatmulTiling cubeTiling(*platform);
        cubeTiling.SetDim(1);  // one cube core computes the whole M x N for one batch
        cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT);
        cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                               matmul_tiling::DataType::DT_FLOAT);
        cubeTiling.SetShape(m, n, k);
        cubeTiling.SetOrgShape(m, n, k);
        if (pr.useFix) {
            cubeTiling.SetFixSplit(pr.baseM, pr.baseN, -1);
        }
        cubeTiling.SetBias(true);
        cubeTiling.SetBufferSpace(-1, -1, -1);
        if (cubeTiling.GetTiling(tiling) == -1) {
            if (pr.useFix) {
                std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): FAILED\n", pr.name, pr.baseM, pr.baseN);
            } else {
                std::fprintf(stderr, "[bmm] tiling probe %s: FAILED\n", pr.name);
            }
            continue;
        }
        if (pr.useFix) {
            std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): OK\n", pr.name, pr.baseM, pr.baseN);
        } else {
            std::fprintf(stderr, "[bmm] tiling probe %s: OK\n", pr.name);
        }
        return true;
    }

    std::fprintf(stderr, "[bmm] GenMatmulTiling failed for M=%d N=%d K=%d after %d probe(s)\n", m, n, k, ladderLen);
    return false;
}

}  // namespace

// Cube MatMul for a single batch: C[0:M*N] = x1(0:M*K) x x2(0:K*N), all fp16,
// fp32 accumulate, bias (all-zero, N floats) added. Mirrors tutorial 03.03.
__global__ __cube__ void bmm_batch_cube(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias,
                                        __gm__ uint8_t* c, __gm__ uint8_t* workspace,
                                        AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    AscendC::GlobalTensor<float> cGlobal;

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);
    mm.IterateAll(cGlobal);
    mm.End();
}

// Vector dot-product fallback for the P2a stand-in shape (M == N == 1). Launched
// as <<<1>>> by run_kernel only when every Cube tiling probe above fails.
//
// Per batch b: acc = sum_t x1[b,0,t] * x2[b,t,0] over the K halves of the batch,
// accumulated in fp32 and written to the y[b] GM slot (exactly 4 bytes).
//
// CANN 9.0.0 / 910B (__NPU_ARCH__ == 2201) facts, verified 2026-09-05 against the
// packaged runtime headers (cann_ascendc_headers_9.0.0):
//   * ReduceSum Level 2 signature is ReduceSum<T, isSetMask>(dst, src,
//     sharedTmpBuffer, count): the intf overload has NO default isSetMask, and
//     dav_c220 ReduceSumImpl folds the whole count with ONE vcadd repeat, so
//     count must not exceed 64 (fp32 lanes per repeat). The sharedTmpBuffer is
//     a required argument but unused on 2201.
//   * DataCopyPad(GlobalTensor dst, LocalTensor src, DataCopyExtParams) is the
//     copy-out overload on non-3510/5102 parts; DataCopyExtParams{blockCount,
//     blockLen, srcStride, dstStride, rsv} has blockLen in BYTES, so a sub-32B
//     store is safe.
//   * DataCopy(LocalTensor dst, GlobalTensor src, uint32 count) copies count
//     elements. Host guarantees K % 16 == 0, so every per-batch GM segment stays
//     32-byte aligned and every segment length is a multiple of 16 halves.
//
// K is therefore consumed in chunks of at most KCH (64) halves; each chunk is
// cast/mul/reduced to one fp32 chunk sum and folded into outLocal[0] with a
// 1-element Add. Correctness first (real throughput tuning is P2b).
//
// Reference (local docs, cross-checked): the cast chain mirrors the
// ascend950_rmsnormquant blog; queue reuse mirrors the light tutorial
// elementwise kernels; the exact 4-byte GM write uses DataCopyPad as documented
// in skills/ascendc-ops-project/references/api_best_practices.md.
//
// Kernel type marker: __vector__, NOT __aicore__ — bisheng only recognises
// __cube__/__vector__/__mix__ for directly-invoked (<<< >>>) kernels and warns
// "kernel type ... is not marked" for __aicore__ (which belongs to old-style
// fill-op kernels). Reference: light 02.06 kernel_pytorch_call add_custom.asc
// uses __global__ __vector__ for the same __gm__ uint8_t* direct-invoke shape.
__global__ __vector__ void bmm_batch_dot(__gm__ uint8_t* aIn, __gm__ uint8_t* bIn, __gm__ uint8_t* yOut,
                                         int32_t bCount, int32_t k)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    // One chunk = one 910B vector repeat: 64 fp32 lanes for cast/mul/reduce, fed
    // by 64 halves (128 B = 4 x 32B MTE2 blocks) per input queue slot.
    constexpr int32_t KCH = 64;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQA;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastA;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastB;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufProd;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQA, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(inQB, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(outQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastA, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastB, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufProd, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, 8 * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> castA = bufCastA.Get<float>();
    LocalTensor<float> castB = bufCastB.Get<float>();
    LocalTensor<float> prod = bufProd.Get<float>();
    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    for (int32_t bIdx = 0; bIdx < bCount; ++bIdx) {
        const int32_t batchBase = bIdx * k;  // half elements

        // Accumulator lives in the copy-out queue so its EnQue/DeQue hands the
        // V -> MTE3 ordering to the 4-byte DataCopyPad below.
        LocalTensor<float> outLocal = outQ.AllocTensor<float>();
        AscendC::Duplicate(outLocal, static_cast<float>(0), KCH);

        int32_t kLeft = k;
        int32_t kOff = 0;
        while (kLeft > 0) {
            const int32_t cnt = (kLeft < KCH) ? kLeft : KCH;  // multiple of 16 halves

            LocalTensor<half> aLocal = inQA.AllocTensor<half>();
            LocalTensor<half> bLocal = inQB.AllocTensor<half>();

            __gm__ half* aSegPtr = reinterpret_cast<__gm__ half*>(aIn) + (batchBase + kOff);
            __gm__ half* bSegPtr = reinterpret_cast<__gm__ half*>(bIn) + (batchBase + kOff);
            AscendC::GlobalTensor<half> aSeg;
            AscendC::GlobalTensor<half> bSeg;
            aSeg.SetGlobalBuffer(aSegPtr, cnt);
            bSeg.SetGlobalBuffer(bSegPtr, cnt);

            AscendC::DataCopy(aLocal, aSeg, cnt);
            AscendC::DataCopy(bLocal, bSeg, cnt);
            inQA.EnQue(aLocal);
            inQB.EnQue(bLocal);

            aLocal = inQA.DeQue<half>();
            bLocal = inQB.DeQue<half>();

            // fp16 -> fp32 (RoundMode is the 4th positional arg BEFORE count in
            // the CANN 9.0.0 Cast Level-2 overload), element-wise product, then
            // fold the <=64 products into one fp32 chunk sum at part[0]. isSetMask
            // must be explicit because the intf overload has no default.
            AscendC::Cast(castA, aLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Cast(castB, bLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Mul(prod, castA, castB, cnt);
            AscendC::ReduceSum<float, true>(part, prod, tmp, cnt);  // chunk sum -> part[0]
            AscendC::Add(outLocal, outLocal, part, 1);              // outLocal[0] += part[0]

            inQA.FreeTensor(aLocal);
            inQB.FreeTensor(bLocal);

            kOff += cnt;
            kLeft -= cnt;
        }

        outQ.EnQue(outLocal);
        outLocal = outQ.DeQue<float>();

        __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(yOut) + bIdx;
        AscendC::GlobalTensor<float> ySeg;
        ySeg.SetGlobalBuffer(yPtr, 1);
        AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
        AscendC::DataCopyPad(ySeg, outLocal, outParams);
        outQ.FreeTensor(outLocal);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    (void)availableCoreNum;

    // --- P2 scope guards (honest boundaries; removed as P2b/P3 land) ---
    if (info_x1.numTensors < 1 || info_x2.numTensors < 1 || info_y.numTensors < 1) {
        std::fprintf(stderr, "[bmm] P2a expects one tensor per input/output group\n");
        return;
    }
    const TensorInfo& t1 = info_x1.tensors[0];
    const TensorInfo& t2 = info_x2.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    if (t1.numDims != 3 || t2.numDims != 3 || ty.numDims != 1) {
        std::fprintf(stderr, "[bmm] P2a expects x1/x2 rank-3 and y rank-1\n");
        return;
    }
    if (t1.dtype != 1 || t2.dtype != 1) {  // fp16 inputs only (P2a); bf16 in P3
        std::fprintf(stderr, "[bmm] P2a supports fp16 inputs only (got x1=%d x2=%d)\n", t1.dtype, t2.dtype);
        return;
    }
    if (ty.dtype != 0) {  // y must be fp32
        std::fprintf(stderr, "[bmm] P2a expects fp32 output (got y=%d)\n", ty.dtype);
        return;
    }
    if (transposeX1 || transposeX2) {
        std::fprintf(stderr, "[bmm] P2a supports transposeX1/transposeX2 == false only\n");
        return;
    }

    const int64_t B = t1.shape[0];
    const int64_t M = t1.shape[1];
    const int64_t K1 = t1.shape[2];
    const int64_t K2 = t2.shape[1];
    const int64_t N = t2.shape[2];
    if (t2.shape[0] != B || K1 != K2 || ty.shape[0] != B) {
        std::fprintf(stderr, "[bmm] inconsistent shapes: x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) y=(%lld)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)t2.shape[0], (long long)K2,
                     (long long)N, (long long)ty.shape[0]);
        return;
    }
    // P2a temporary limitation: the y stand-in below is exact only for M == N == 1.
    if (M != 1 || N != 1) {
        std::fprintf(stderr, "[bmm] P2a limitation: only M==1 && N==1 is supported until P2b reduction kernel\n");
        return;
    }

    // x1/x2/y are GM_ADDR = __gm__ uint8_t*. Keep the qualifier end-to-end:
    // bisheng rejects reinterpret_cast that drops __gm__ (cloud build error on
    // 2026-09-05), so no plain-pointer alias of a GM tensor may be formed here.
    __gm__ uint8_t* x1Base = x1;
    __gm__ uint8_t* x2Base = x2;
    __gm__ uint8_t* yBase = y;

    // --- P2a case0 verdict (2026-09-05 cloud evidence) ---
    // The MultiCoreMatmulTiling ladder accepts the no-SetFixSplit probe for
    // (1,1,32) (v0 fixed (128,128): FAILED; v1 no SetFixSplit: OK), but the
    // resulting Cube kernel run then dies with "aclrtSynchronizeStreamWithTimeout
    // failed, ret=507015". GetTiling() succeeding does NOT mean the Cube engine
    // can execute a 1x1 tile, so under the P2a M==N==1 guard, case0 is ALWAYS
    // routed to the vector dot-product fallback. The Cube block below is
    // unreachable until P2b lifts this guard for real M/N shapes.
    if (K1 % 16 == 0) {
        std::fprintf(stderr, "[bmm] run path: VECTOR DOT FALLBACK (case0 forced: B=%lld K=%lld)\n",
                     (long long)B, (long long)K1);
        bmm_batch_dot<<<1, nullptr, stream>>>(x1Base, x2Base, yBase, static_cast<int32_t>(B),
                                              static_cast<int32_t>(K1));
        return;
    }
    std::fprintf(stderr, "[bmm] P2a boundary: K=%lld is not a multiple of 16 "
                         "(vector fallback needs 32-byte-aligned segments)\n",
                 (long long)K1);
    return;

    // ===== Unreachable under the P2a guard above; P2b scaffolding =====
    // Real M/N shapes reactivate this cube ladder/path once the M==N==1 guard is
    // lifted. (2026-09-05 cloud log: ladder v0 FAILED / v1 OK for (1,1,32), but
    // cube execution of the 1x1 tile crashed with ret=507015 — do not re-enable
    // for 1x1 without fresh evidence.)
    platform_ascendc::PlatformAscendC* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        std::fprintf(stderr, "[bmm] PlatformAscendCManager::GetInstance() returned nullptr\n");
        return;
    }

    AscendC::tiling::TCubeTiling tiling;
    if (GenBatchMatmulTiling(platform, tiling, static_cast<int32_t>(M), static_cast<int32_t>(N),
                             static_cast<int32_t>(K1))) {
        // --- Cube path: per-batch bmm_batch_cube writes C[0,0] straight into y[b]. ---
        std::fprintf(stderr, "[bmm] run path: CUBE (per-batch MatMul -> y GM stand-in)\n");

        const int64_t wsBytes = static_cast<int64_t>(platform->GetLibApiWorkSpaceSize());
        const int64_t biasBytes = N * static_cast<int64_t>(sizeof(float));

        // x1/x2/y are already live in GM (device pointers handed to run_kernel). The
        // kernel writes its M==N==1 C output straight into y's GM slot, so no temp C
        // buffer and no host-side D2D copy are needed.
        uint8_t* biasDevice = nullptr;
        uint8_t* wsDevice = nullptr;
        auto aclErr = aclrtMalloc(reinterpret_cast<void**>(&biasDevice), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        if (wsBytes > 0) {
            aclErr = (aclErr != ACL_SUCCESS)
                         ? aclErr
                         : aclrtMalloc(reinterpret_cast<void**>(&wsDevice), wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        }
        if (aclErr != ACL_SUCCESS) {
            std::fprintf(stderr, "[bmm] aclrtMalloc failed ret=%d\n", aclErr);
            if (biasDevice != nullptr) aclrtFree(biasDevice);
            if (wsDevice != nullptr) aclrtFree(wsDevice);
            return;
        }

        // bias is all zeros so C = pure batch matmul.
        if (aclrtMemsetAsync(biasDevice, biasBytes, 0, biasBytes, stream) != ACL_SUCCESS) {
            std::fprintf(stderr, "[bmm] aclrtMemsetAsync(bias) failed\n");
            aclrtFree(biasDevice);
            if (wsDevice != nullptr) aclrtFree(wsDevice);
            return;
        }

        for (int64_t b = 0; b < B; ++b) {
            __gm__ uint8_t* aBatch = x1Base + b * M * K1 * static_cast<int64_t>(sizeof(uint16_t));
            __gm__ uint8_t* bBatch = x2Base + b * K2 * N * static_cast<int64_t>(sizeof(uint16_t));
            // M == N == 1: the cube C output C[0,0] IS y[b]. Pointing the kernel's
            // 'c' straight at y's GM slot is the P2a stand-in for the P2b Vector
            // reduction (no temp buffer, no D2D copy, no __gm__ -> void* conversion).
            __gm__ uint8_t* cBatch = yBase + b * M * N * static_cast<int64_t>(sizeof(float));
            bmm_batch_cube<<<1, nullptr, stream>>>(aBatch, bBatch, biasDevice, cBatch, wsDevice, tiling);
        }

        aclrtFree(biasDevice);
        if (wsDevice != nullptr) aclrtFree(wsDevice);
        return;
    }
    // (The vector fallback and the K-alignment boundary check live ABOVE the
    // cube block; this whole cube block is unreachable under the P2a M==N==1
    // guard and is kept only as P2b scaffolding for real M/N shapes.)
}

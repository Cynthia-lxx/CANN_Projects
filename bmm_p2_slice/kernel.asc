/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included by main.asc — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * P2 vertical-slice milestone plan (parent plan P2, 2026-09-05):
 *   P2a [done]: fp16 Vector dot-product slice (case0-only route). Cloud verdict
 *     2026-09-05 (run.sh on the 910B CANN Lab): the Cube path is NOT usable for
 *     a 1x1 tile — the MultiCoreMatmulTiling ladder accepts the no-SetFixSplit
 *     probe for (1,1,32) (v0 fixed (128,128) FAILED, v1 OK), but the Cube run
 *     then dies with "aclrtSynchronizeStreamWithTimeout failed, ret=507015":
 *     GetTiling() success does NOT imply the Cube engine can execute 1x1.
 *     Under the P2a M==N==1 guard, case0 was ALWAYS routed to bmm_batch_dot
 *     (__vector__, fp32-accumulated dot, exact 4-byte DataCopyPad store per
 *     batch); numerically EXACT only for M == N == 1.
 *   P2b [done]: real M/N slice (B=1, M=N=K=64) via Cube -> temp C GM -> bmm_reduce.
 *     y[b] = sum over the M rows of each row's MAX over its N entries, i.e.
 *     y[b] = sum_m max_n C[b][m][n]  (matches impl.py: max along N, sum along M).
 *     Cloud verdict history: ASCENDC_CUBE_ONLY (#defined below) killed a ret=507015
 *     aicore fault; an early numeric mismatch was a reduce DIRECTION bug (correct
 *     order is first-N-max then M-sum, now fixed). Verdict keyed on the
 *     "run path:" line + verify_result.py PASSED/FAILED.
 *   P3 [this file, fix/p3-fullshape-fused]: full-statement shape domain
 *     (B<=64, M,N<=8192, K mult of 8). The P2b temp C GM buffer is gone: one
 *     __mix__(1,2) core per batch runs bmm_batch_fused, whose Matmul object emits
 *     C to VECIN (tiling vecInC=true), GetTensorC<true> sync-copies each
 *     baseM x baseN tile into UB, and the AIV units contract the tile in-kernel
 *     (per-row chunk ReduceMax over N folded into a running max, then a final
 *     64-lane ReduceSum over M). Only B fp32 y[b] slots leave the device, so the
 *     B x M x N x 4B C intermediate never exists in GM (~17 GB at B=64 M=N=8192
 *     K=32 under the P2b scheme). M==N==1 keeps the P2a vector dot fallback.
 *     Design/verdict record: .codebuddy/plans/P3_fullshape_fused_reduce_arch.md.
 *
 * Reference notes (local docs, cross-checked):
 *   - fp16 cube skeleton:     ascendc_operator_development_light/03_simple_operator_practice/answer/03.03/matmul_custom.asc
 *   - cube+vector mix kernel: .../answer/03.05/matmul_abs.asc  (__mix__(1,2), __kfc_workspace__)
 *   - fused C-in-UB via VECIN: .../ascendc_operator_development/05_fused_operator_development/answer/05.04_answer/op_kernel/matmul_abs.cpp
 */

#include <cstdint>
#include <cstdio>
#include <cfloat>

#include "acl/acl.h"
#include "kernel_operator.h"
// 2026-09-06 P3: ASCENDC_CUBE_ONLY is deliberately NOT defined. P2b proved it
// fixes the ret=507015 of a PURE __cube__ kernel: under SPLIT_CORE_CUBE,
// kfc_register_obj.h (9.0.0 head copy) expands REGIST_CUBE_OBJ to a KfcServer
// loop unless ASCENDC_CUBE_ONLY flips it to InitCurObj. The P3 __mix__(1,2)
// fused kernel is the opposite case: its vector/master pass compiles under
// SPLIT_CORE_VEC, where ASCENDC_CUBE_ONLY would expand REGIST_CUBE_OBJ to a bare
// `return` (kfc_register_obj.h ~line 324) and kill the whole reduction body.
// Official __mix__ direct-invocation samples (light 03.05 matmul_abs.asc,
// 03.07 matmul_sinh.asc) therefore include lib/matmul_intf.h WITHOUT the macro:
// the KfcServer/KfcCommClient split makes the AIC run a server loop while the
// AIV is the master that SetMatrixKfc-dispatches mm work and runs the fused
// tile loop. bmm_batch_cube / bmm_reduce below are kept only as reference and
// are DEAD CODE in the P3 path (never launched); re-activating the pure-Cube
// pipeline requires #define ASCENDC_CUBE_ONLY again before this include
// (see git branch fix/p2b-cube-real-shape).
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

namespace {

struct FixSplitProbe {
    const char* name;  // log tag of the candidate
    bool useFix;       // false -> SetFixSplit() is not called at all
    int32_t baseM;
    int32_t baseN;
};

bool ProbeDup(const FixSplitProbe* ladder, int32_t len, const FixSplitProbe& cand)
{
    for (int32_t i = 0; i < len; ++i) {
        if (!ladder[i].useFix) {
            if (!cand.useFix) return true;  // only one "no SetFixSplit" probe
            continue;
        }
        if (cand.useFix && ladder[i].baseM == cand.baseM && ladder[i].baseN == cand.baseN) return true;
    }
    return false;
}

void PushProbe(FixSplitProbe* ladder, int32_t* len, const FixSplitProbe& cand)
{
    if (ProbeDup(ladder, *len, cand)) return;
    ladder[(*len)++] = cand;
}

// Deterministic probe ladder for matmul_tiling::SetFixSplit(). v0 is the
// official tutorial default (128, 128); v1..v5 are relaxed/adaptive probes.
// Every probe gets a FRESH MultiCoreMatmulTiling (the object is single-use) and
// all other options stay byte-for-byte identical to the official tutorial; the
// first probe that yields a valid TCubeTiling wins. P2a used the same ladder to
// prove the Cube path cannot execute a 1x1 tile; P2b uses it to prove a real
// aligned shape (case0: M=N=K=64) is accepted — the cloud log records which
// probe hits for a real M/N shape.
// vecInC == true selects the P3 fused path: C is emitted to VECIN (L0C -> UB via
// GetTensorC) instead of GM, and the traversal is pinned to FIRSTM so the fused
// kernel can derive each tile's row block from the Iterate round count exactly as
// 03.05/05.04 CopyOut does (startOffset = count%roundM * baseM*N + ...).
bool GenBatchMatmulTiling(platform_ascendc::PlatformAscendC* platform, AscendC::tiling::TCubeTiling& tiling,
                          int32_t m, int32_t n, int32_t k, bool vecInC = false)
{
    const int32_t adM = (m < 128) ? m : 128;  // adaptive base = shape capped at the official default
    const int32_t adN = (n < 128) ? n : 128;

    constexpr int32_t kMaxProbes = 8;
    FixSplitProbe ladder[kMaxProbes];
    int32_t ladderLen = 0;

    PushProbe(ladder, &ladderLen, {"v0 official SetFixSplit(128,128)", true, 128, 128});
    PushProbe(ladder, &ladderLen, {"v1 no SetFixSplit", false, 0, 0});
    PushProbe(ladder, &ladderLen, {"v2 adaptive SetFixSplit(min(shape,128))", true, adM, adN});
    PushProbe(ladder, &ladderLen, {"v3 SetFixSplit(16,16)", true, 16, 16});
    PushProbe(ladder, &ladderLen, {"v4 SetFixSplit(8,8)", true, 8, 8});
    PushProbe(ladder, &ladderLen, {"v5 SetFixSplit(1,1)", true, 1, 1});

    for (int32_t p = 0; p < ladderLen; ++p) {
        const FixSplitProbe& pr = ladder[p];
        matmul_tiling::MultiCoreMatmulTiling cubeTiling(*platform);
        cubeTiling.SetDim(1);  // one cube core computes the whole M x N for one batch
        cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT16);
        if (vecInC) {
            // P3 fused path: C must land in the vector engine's L0C->UB lane so the
            // __mix__ kernel can GetTensorC each baseM x baseN tile and contract it
            // in-kernel (03.05/05.04 SetCType(VECIN, ND, float)). FIRSTM traversal
            // keeps the tile->row-block mapping identical to 03.05/05.04 CopyOut.
            cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                                matmul_tiling::DataType::DT_FLOAT);
            cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
        } else {
            cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                                matmul_tiling::DataType::DT_FLOAT);
        }
        cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                               matmul_tiling::DataType::DT_FLOAT);
        cubeTiling.SetShape(m, n, k);
        cubeTiling.SetOrgShape(m, n, k);
        if (pr.useFix) {
            cubeTiling.SetFixSplit(pr.baseM, pr.baseN, -1);
        }
        cubeTiling.SetBias(true);
        cubeTiling.SetBufferSpace(-1, -1, -1);
        if (cubeTiling.GetTiling(tiling) == -1) {
            if (pr.useFix) {
                std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): FAILED\n", pr.name, pr.baseM, pr.baseN);
            } else {
                std::fprintf(stderr, "[bmm] tiling probe %s: FAILED\n", pr.name);
            }
            continue;
        }
        if (pr.useFix) {
            std::fprintf(stderr, "[bmm] tiling probe %s base=(%d,%d): OK\n", pr.name, pr.baseM, pr.baseN);
        } else {
            std::fprintf(stderr, "[bmm] tiling probe %s: OK\n", pr.name);
        }
        // 507015 diagnosis dump (2026-09-06): M/N/Ka/Kb drive the GM-buffer views
        // in bmm_batch_cube, singleCore*/base* reflect the actual cube tile the
        // tiling library picked. A mismatch of M/N/Ka/Kb vs the requested shape
        // means the GM views overrun the batch slices; baseK > K is the known
        // CCU-tile kL0 overrun trigger (pypto machine.md §7).
        std::fprintf(stderr,
            "[bmm] probe %s tiling dump: M=%d N=%d Ka=%d Kb=%d singleCore(M=%d,N=%d,K=%d) "
            "base(M=%d,N=%d,K=%d) usedCores=%d isBias=%d\n",
            pr.name, tiling.M, tiling.N, tiling.Ka, tiling.Kb, tiling.singleCoreM,
            tiling.singleCoreN, tiling.singleCoreK, tiling.baseM, tiling.baseN, tiling.baseK,
            tiling.usedCoreNum, tiling.isBias);
        return true;
    }

    std::fprintf(stderr, "[bmm] GenMatmulTiling failed for M=%d N=%d K=%d after %d probe(s)\n", m, n, k, ladderLen);
    return false;
}

}  // namespace

// Cube MatMul for a single batch: C[0:M*N] = x1(0:M*K) x x2(0:K*N), all fp16,
// fp32 accumulate, bias (all-zero, N floats) added. Mirrors tutorial 03.03.
//
// Audit vs official skeleton (2026-09-06, 910B = DAV_2201 / dav_c220; sources:
// light 03.03 matmul_custom.asc; cannbot api-matmul.md §7 skeleton + §8 list;
// cann_ascendc_headers_9.0.0). Body is line-for-line the 03.03 __cube__ original,
// so every "missing" §7 item is EITHER done by the macro, a default, or belongs
// to another form — no code patch needed:
//   - AIC guard (ASCEND_IS_AIV) / LoadTilingFromGM / blockIdx>=totalBlock guard:
//     AIV- and multi-core GM-tiling-skeleton specifics; NOT applicable to this
//     __cube__ single-core kernel with a by-value TCubeTiling.
//   - SetSubBlockIdx(0)+Init: REGIST_MATMUL_OBJ auto-runs both whenever a tiling
//     pointer arg is present (kfc_register_obj.h InitCurObj).
//   - SetHF32(false,0): MatmulImplBase default arg = full FP32 (KEEP_FLOAT_DTYPE),
//     paired with host default MatrixMadType::NORMAL; HF32 never activates unless
//     BOTH sides opt in.
//   - MM_CFG_NO_PRELOAD: default config already has enUnitFlag=true.
//   - PipeBarrier<PIPE_AIC>+SetAtomicNone: for in-kernel manual L0C rewind so a
//     VECTOR unit in the same kernel can consume C; IterateAll(cGlobal) writes C
//     back to GM via fixpipe and the same host stream orders bmm_reduce (cube
//     writes C before reduce reads it), so no in-kernel barrier is required.
//  507015 (2026-09-05 cloud: GetTiling OK but the Cube run on a 1x1 tile died
//   ret=507015) therefore means: a successful GetTiling does NOT imply the Cube
//   engine can execute that tile. A SECOND known 507015 trigger is feeding a
//   TilingHeader fetched via UB/L1 GetPhyAddr into Init — this kernel passes the
//   TCubeTiling by value (naturally stack-resident) and never does that.
//  workspace: host wsBytes = platform->GetLibApiWorkSpaceSize() (run_kernel),
//  aclrtMalloc'ed and passed as kernel arg; on 2201 GetSysWorkSpacePtr() =
//  __get_kfc_workspace_addr(). The size MUST come from the library — an undersized
//  buffer overruns the KFC comm area and surfaces as a GM/sync-class aicore fault
//  (507015 family), not as a compile error.
//  2026-09-06: CUBE_ONLY hypothesis CLOSED (head-inspected, cann_ascendc_
//  headers_9.0.0). In a non-CPU_DEBUG build REGIST_MATMUL_OBJ == REGIST_CUBE_OBJ
//  (matmul_intf.h) and on 2201 without SPLIT_CORE_* / ASCENDC_MATMUL_AICORE the
//  macro takes its DEFAULT else branch (kfc_register_obj.h) = InitCurObj ->
//  SetSubBlockIdx(0) + Init. ASCENDC_CUBE_ONLY only matters under SPLIT_CORE_CUBE
//  / SPLIT_CORE_VEC / CPU_DEBUG / __NPU_ARCH__==3510, so NOT defining it is NOT
//  the 507015 trigger on this __cube__ direct-invocation shape.
//  SUPERSEDED 2026-09-06 evening: cloud round 2 dumped a FULLY LEGAL tiling
//  (M=N=Ka=Kb=64, singleCore 64/64/64, base 64/64/64, usedCores=1, isBias=1) for
//  the real 64 shape yet the cube run STILL died ret=507015 — the same signature
//  as the 1x1 P2a case. GM-view and kL0-overrun hypotheses are thereby both
//  disproved. With the kernel body proven line-for-line identical to light
//  03.03/03.06 matmul_custom.asc, ASCENDC_CUBE_ONLY (defined right before
//  lib/matmul_intf.h there) is the only remaining delta, so it was flipped on as
//  the controlled experiment (see the #define block above).
//  RESOLVED 2026-09-06 (cloud round 3): the experiment PASSED — with
//  ASCENDC_CUBE_ONLY defined the cube kernel ran the real 64 shape with NO
//  507015. The remaining numeric mismatch (max diff ~331) was an independent
//  bmm_reduce DIRECTION bug — sum-over-N-then-max-over-M was implemented instead
//  of max-over-N-then-sum-over-M (impl.py: np.max(axis=-1) then np.sum(axis=-1))
//  — fixed in the bmm_reduce block below.
//
// DEAD CODE in the P3 path (2026-09-06): run_kernel no longer launches this
// kernel or bmm_reduce — the __mix__ fused kernel replaces the whole
// "Cube -> temp C GM -> bmm_reduce" pipeline. Kept for reference; re-activating
// it needs #define ASCENDC_CUBE_ONLY before #include "lib/matmul_intf.h"
// (see the top-of-file note).
__global__ __cube__ void bmm_batch_cube(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias,
                                        __gm__ uint8_t* c, __gm__ uint8_t* workspace,
                                        AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    AscendC::GlobalTensor<float> cGlobal;

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);
    mm.IterateAll(cGlobal);
    mm.End();
}

// Vector dot-product fallback for M == N == 1 (kept from P2a). Launched as <<<1>>>
// by run_kernel for every single-point batch because the Cube engine cannot
// execute a 1x1 tile (2026-09-05 cloud evidence: GetTiling OK, run ret=507015).
//
// Per batch b: acc = sum_t x1[b,0,t] * x2[b,t,0] over the K halves of the batch,
// accumulated in fp32 and written to the y[b] GM slot (exactly 4 bytes).
//
// CANN 9.0.0 / 910B (__NPU_ARCH__ == 2201) facts, verified 2026-09-05 against the
// packaged runtime headers (cann_ascendc_headers_9.0.0):
//   * ReduceSum Level 2 signature is ReduceSum<T, isSetMask>(dst, src,
//     sharedTmpBuffer, count): the intf overload has NO default isSetMask, and
//     dav_c220 ReduceSumImpl folds the whole count with ONE vcadd repeat, so
//     count must not exceed 64 (fp32 lanes per repeat). The sharedTmpBuffer is
//     a required argument but unused on 2201.
//   * DataCopyPad(GlobalTensor dst, LocalTensor src, DataCopyExtParams) is the
//     copy-out overload on non-3510/5102 parts; DataCopyExtParams{blockCount,
//     blockLen, srcStride, dstStride, rsv} has blockLen in BYTES, so a sub-32B
//     store is safe.
//   * DataCopy(LocalTensor dst, GlobalTensor src, uint32 count) copies count
//     elements. Host guarantees K % 16 == 0, so every per-batch GM segment stays
//     32-byte aligned and every segment length is a multiple of 16 halves.
//
// K is therefore consumed in chunks of at most KCH (64) halves; each chunk is
// cast/mul/reduced to one fp32 chunk sum and folded into outLocal[0] with a
// 1-element Add. Correctness first (throughput tuning is a later milestone).
//
// Reference (local docs, cross-checked): the cast chain mirrors the
// ascend950_rmsnormquant blog; queue reuse mirrors the light tutorial
// elementwise kernels; the exact 4-byte GM write uses DataCopyPad as documented
// in skills/ascendc-ops-project/references/api_best_practices.md.
//
// Kernel type marker: __vector__, NOT __aicore__ — bisheng only recognises
// __cube__/__vector__/__mix__ for directly-invoked (<<< >>>) kernels and warns
// "kernel type ... is not marked" for __aicore__ (which belongs to old-style
// fill-op kernels). Reference: light 02.06 kernel_pytorch_call add_custom.asc
// uses __global__ __vector__ for the same __gm__ uint8_t* direct-invoke shape.
__global__ __vector__ void bmm_batch_dot(__gm__ uint8_t* aIn, __gm__ uint8_t* bIn, __gm__ uint8_t* yOut,
                                         int32_t bCount, int32_t k)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    // One chunk = one 910B vector repeat: 64 fp32 lanes for cast/mul/reduce, fed
    // by 64 halves (128 B = 4 x 32B MTE2 blocks) per input queue slot.
    constexpr int32_t KCH = 64;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQA;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastA;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufCastB;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufProd;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQA, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(inQB, 1, KCH * static_cast<int32_t>(sizeof(half)));
    pipe.InitBuffer(outQ, 1, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastA, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufCastB, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufProd, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, KCH * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, 8 * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> castA = bufCastA.Get<float>();
    LocalTensor<float> castB = bufCastB.Get<float>();
    LocalTensor<float> prod = bufProd.Get<float>();
    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    for (int32_t bIdx = 0; bIdx < bCount; ++bIdx) {
        const int32_t batchBase = bIdx * k;  // half elements

        // Accumulator lives in the copy-out queue so its EnQue/DeQue hands the
        // V -> MTE3 ordering to the 4-byte DataCopyPad below.
        LocalTensor<float> outLocal = outQ.AllocTensor<float>();
        AscendC::Duplicate(outLocal, static_cast<float>(0), KCH);

        int32_t kLeft = k;
        int32_t kOff = 0;
        while (kLeft > 0) {
            const int32_t cnt = (kLeft < KCH) ? kLeft : KCH;  // multiple of 16 halves

            LocalTensor<half> aLocal = inQA.AllocTensor<half>();
            LocalTensor<half> bLocal = inQB.AllocTensor<half>();

            __gm__ half* aSegPtr = reinterpret_cast<__gm__ half*>(aIn) + (batchBase + kOff);
            __gm__ half* bSegPtr = reinterpret_cast<__gm__ half*>(bIn) + (batchBase + kOff);
            AscendC::GlobalTensor<half> aSeg;
            AscendC::GlobalTensor<half> bSeg;
            aSeg.SetGlobalBuffer(aSegPtr, cnt);
            bSeg.SetGlobalBuffer(bSegPtr, cnt);

            AscendC::DataCopy(aLocal, aSeg, cnt);
            AscendC::DataCopy(bLocal, bSeg, cnt);
            inQA.EnQue(aLocal);
            inQB.EnQue(bLocal);

            aLocal = inQA.DeQue<half>();
            bLocal = inQB.DeQue<half>();

            // fp16 -> fp32 (RoundMode is the 4th positional arg BEFORE count in
            // the CANN 9.0.0 Cast Level-2 overload), element-wise product, then
            // fold the <=64 products into one fp32 chunk sum at part[0]. isSetMask
            // must be explicit because the intf overload has no default.
            AscendC::Cast(castA, aLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Cast(castB, bLocal, AscendC::RoundMode::CAST_NONE, cnt);
            AscendC::Mul(prod, castA, castB, cnt);
            AscendC::ReduceSum<float, true>(part, prod, tmp, cnt);  // chunk sum -> part[0]
            AscendC::Add(outLocal, outLocal, part, 1);              // outLocal[0] += part[0]

            inQA.FreeTensor(aLocal);
            inQB.FreeTensor(bLocal);

            kOff += cnt;
            kLeft -= cnt;
        }

        outQ.EnQue(outLocal);
        outLocal = outQ.DeQue<float>();

        __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(yOut) + bIdx;
        AscendC::GlobalTensor<float> ySeg;
        ySeg.SetGlobalBuffer(yPtr, 1);
        AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
        AscendC::DataCopyPad(ySeg, outLocal, outParams);
        outQ.FreeTensor(outLocal);
    }
}

// P2b dedicated vector reduction kernel over C in GM:
//     y[b] = sum over the M rows of each row's MAX over its N entries
//          = sum_m max_n C[b][m][n]
// C is the per-batch cube MatMul output (B*M*N fp32, row-major ND, already in
// GM). Launched as <<<1>>> after the cube kernel on the SAME stream, so the C
// buffer it reads is ordered after the cube writes.
//
// CANN 9.0.0 / 910B (__NPU_ARCH__ == 2201) API facts, verified 2026-09-06 against
// cann_ascendc_headers_9.0.0:
//   * ReduceMax Level-2 count version: ReduceMax(dst, src, sharedTmpBuffer,
//     count, calIndex = 0) — basic_api/kernel_operator_vec_reduce_intf.h. On
//     2201 (the non-3510/5102/3003/3113 else-branch in
//     basic_api/impl/kernel_operator_vec_reduce_intf_impl.h) it runs the SAME
//     ReduceImpl tree as ReduceSum with ReduceMode::REDUCE_MAX and asserts
//     half/float only; fp32 elementNumPerRep = 64, so count == N <= 64 is a
//     single-repeat whole-reduce (guarded by run_kernel's N<=64). The result
//     value lands in dst[0] exactly like ReduceSum's chunk-sum.
//   * Level-2 "Add(dst, src0, src1, count)" (kernel_operator_vec_binary_intf.h)
//     with count = 1 folds each row max into acc[0] (usage proven in P2a).
//   * DataCopy(LocalTensor, GlobalTensor, count) / DataCopyPad{1,4,0,0,0} and
//     the VECIN/VECOUT queue ordering pattern are the same as in bmm_batch_dot.
//
// Design (no scalar reads/writes anywhere): acc[0] starts at 0.0f; every row max
// lands in part[0] via ReduceMax and is folded into acc[0] with Add(...,1). acc
// lives in the VECOUT slot, so its EnQue/DeQue hands the V -> MTE3 ordering to
// the 4-byte DataCopyPad store. 2026-09-06 FIX: an earlier version computed
// max-over-M of (sum-over-N) rows — i.e. the two reductions were swapped vs the
// spec (impl.py does max along N, then sum along M) — which produced the ~331
// max diff of cloud round 3.
//
// DEAD CODE in the P3 path (2026-09-06): the fused __mix__ kernel has replaced
// the whole "Cube -> temp C GM -> bmm_reduce" pipeline, and the temp C GM
// buffer no longer exists. Kept for reference and for its API-fact audit.
__global__ __vector__ void bmm_reduce(__gm__ uint8_t* cIn, __gm__ uint8_t* yOut, int32_t bCount,
                                      int32_t m, int32_t n)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    // One row = n fp32. n <= 64 (guarded by run_kernel) so a whole row fits the
    // single-repeat whole-reduce budget (fp32 elementNumPerRep = 64) and one
    // 256B DataCopy per row.
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQ, 1, n * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, n * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, n * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, n * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    for (int32_t bIdx = 0; bIdx < bCount; ++bIdx) {
        __gm__ float* cBatch = reinterpret_cast<__gm__ float*>(cIn) + static_cast<int64_t>(bIdx) * m * n;

        // acc[0] accumulates the SUM over the M rows of each row's MAX over N.
        LocalTensor<float> acc = outQ.AllocTensor<float>();
        AscendC::Duplicate(acc, static_cast<float>(0), n);  // acc[0] = 0.0f
        for (int32_t i = 0; i < m; ++i) {
            LocalTensor<float> row = inQ.AllocTensor<float>();

            __gm__ float* rowPtr = cBatch + static_cast<int64_t>(i) * n;
            AscendC::GlobalTensor<float> rowSeg;
            rowSeg.SetGlobalBuffer(rowPtr, n);
            AscendC::DataCopy(row, rowSeg, n);  // one 256B MTE2 block per row
            inQ.EnQue(row);

            row = inQ.DeQue<float>();
            AscendC::ReduceMax(part, row, tmp, n);  // part[0] = max over this row's N entries
            AscendC::Add(acc, acc, part, 1);        // acc[0] += row max
            inQ.FreeTensor(row);
        }

        outQ.EnQue(acc);
        acc = outQ.DeQue<float>();

        __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(yOut) + bIdx;
        AscendC::GlobalTensor<float> ySeg;
        ySeg.SetGlobalBuffer(yPtr, 1);
        AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
        AscendC::DataCopyPad(ySeg, acc, outParams);
        outQ.FreeTensor(acc);
    }
}

// ===== P3 fused kernel: one batch -> y[b], no full-C GM buffer =====
// 2026-09-06. Audit: cann_ascendc_headers_9.0.0 + light 03.05 / 05.04
// (Matmul<..., CType=VECIN ...> + Iterate<true> + GetTensorC<true>, C tile in a
// VECOUT queue slot, FIRSTM traversal => mBlock = count % roundM as in 03.05
// CopyOut). The kernel is __mix__(1,2): the cube engine produces each baseM x
// baseN C tile, GetTensorC sync-copies L0C -> UB, and the AIV units immediately
// contract that tile into a per-row running max, so the B x M x N x 4B C
// intermediate never materializes in GM (at B=64, M=N=8192, K=32 that buffer
// would be ~17 GB).
//
// Reduction, in the verified order (np.max over N first, np.sum over M second):
//   runningMax[row] = -FLT_MAX  (identity; a fully-negative row must return its
//                               largest negative value, NOT 0)
//   for each tile (covers rows [mBlock*baseM, mBlock*baseM+baseM)):
//     for each row r, for each N chunk (<=64 lanes, single-repeat whole-reduce):
//       ReduceMax(part, tile[r*baseN + chunk], tmp, chunkLen) -> part[0]
//       Max(runningMax[row], runningMax[row], part, 1)   # fold into row max
//   ReduceSum(runningMax) over M (64-lane chunks) -> y[b]
//
// The kernel owns the WHOLE batch (host launches one mix core per batch with the
// per-batch x1/x2 slice base pointer + that batch's y slot), i.e. the tiling must
// give usedCoreNum==1 and singleCoreM==tiling.M (host guard, P4 = multi-core).
__global__ __mix__(1, 2) void bmm_batch_fused(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias,
                                              __gm__ uint8_t* ySlot, __gm__ uint8_t* __kfc_workspace__ workspace,
                                              AscendC::tiling::TCubeTiling tiling)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    constexpr int32_t kChunk = 64;  // fp32 lanes per vector repeat = whole-reduce budget
    const uint32_t baseM = tiling.baseM;
    const uint32_t baseN = tiling.baseN;
    const uint32_t singleCoreM = tiling.singleCoreM;
    const uint32_t roundM = singleCoreM / baseM;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> tileQ;   // GetTensorC C-tile slot (05.04 idiom)
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;    // y[b] accumulator slot
    AscendC::TBuf<AscendC::TPosition::VECOUT> bufRunning;   // per-row running max (can be M*4B)
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(tileQ, 1, baseM * baseN * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, kChunk * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufRunning, singleCoreM * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, kChunk * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, kChunk * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> runningMax = bufRunning.Get<float>();
    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);

    // runningMax must be initialised AFTER REGIST_MATMUL_OBJ: on the mix
    // kernel's cube pass REGIST expands to a KfcServer loop (kfc_register_obj.h)
    // and only the vector/master pass reaches this point, so no vector
    // instruction may precede REGIST (official 03.05/03.07 mix kernels do the
    // same — REGIST is their first executable statement).
    AscendC::Duplicate(runningMax, static_cast<float>(-3.4028234663852886e+38), singleCoreM);

    uint32_t count = 0;
    while (mm.template Iterate<true>()) {  // one round = one baseM x baseN C tile
        LocalTensor<float> tile = tileQ.AllocTensor<float>();
        mm.template GetTensorC<true>(tile, false, true);

        // FIRSTM: mBlock cycles fastest => count % roundM (03.05 CopyOut formula).
        // The ReduceMax SOURCE tile[r*baseN+col] is repeat-aligned as long as
        // baseN is a multiple of 64 (fp32 lanes per repeat); the tiling dump in
        // GenBatchMatmulTiling prints baseN so a cloud round confirms this.
        const uint32_t mBlock = count % roundM;
        const uint32_t rowBase = mBlock * baseM;
        for (uint32_t r = 0; r < baseM; ++r) {
            const uint32_t globalRow = rowBase + r;  // row index inside runningMax
            LocalTensor<float> runningRow = runningMax[globalRow];  // offset sub-view
            uint32_t col = 0;
            while (col < baseN) {
                const int32_t seg = (baseN - col < static_cast<uint32_t>(kChunk))
                                        ? static_cast<int32_t>(baseN - col)
                                        : kChunk;
                AscendC::ReduceMax(part, tile[r * baseN + col], tmp, seg);  // part[0] = chunk max
                // THE ONE UNVERIFIED ASSUMPTION OF THE FUSED KERNEL: the fold below
                // is a count-mode elementwise op at an ARBITRARY element offset
                // (globalRow), i.e. 4-byte granular — P2b only ever ran count-mode
                // ops at 64-lane-aligned offsets (acc[0], baseN-multiple chunks).
                // CANNBot best practice (ascendc-api-best-practices/api-reduce.md
                // error 6) flags 8-byte dst alignment for REDUCE dst; no offline
                // ground truth exists for elementwise Max at a sub-repeat offset
                // (MaxImpl is a compiler builtin). DISCRIMINATOR = case0 with
                // M=64: odd globalRow (1,3,5,...) is a 4-byte-only offset, so any
                // 8B/32B mask-unit granularity corrupts neighbour rows and the
                // y vs golden diff fails loudly. If it does, fall back to the GM
                // row-state design (memory note 2026-09-06, P3 section).
                AscendC::Max(runningRow, runningRow, part, 1);              // fold into row max
                col += static_cast<uint32_t>(seg);
            }
        }

        // EnQue/DeQue keep the queue discipline of the official fused samples even
        // though there is no MTE3 copy-out stage: the slot must be handed back
        // only after every AIV instruction above has retired.
        tileQ.EnQue(tile);
        tile = tileQ.DeQue<float>();
        tileQ.FreeTensor(tile);
        ++count;
    }
    mm.End();

    // ReduceSum runningMax[0..M) in 64-lane chunks into y[b].
    LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, static_cast<float>(0), kChunk);  // acc[0] = 0
    uint32_t off = 0;
    while (off < singleCoreM) {
        const int32_t seg = (singleCoreM - off < static_cast<uint32_t>(kChunk))
                                ? static_cast<int32_t>(singleCoreM - off)
                                : kChunk;
        AscendC::ReduceSum<float, true>(part, runningMax[off], tmp, seg);  // part[0] = chunk sum
        AscendC::Add(acc, acc, part, 1);
        off += static_cast<uint32_t>(seg);
    }
    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();

    __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(ySlot);
    AscendC::GlobalTensor<float> ySeg;
    ySeg.SetGlobalBuffer(yPtr, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(ySeg, acc, outParams);
    outQ.FreeTensor(acc);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    (void)availableCoreNum;

    // --- P3 scope guards (honest boundaries) ---
    if (info_x1.numTensors < 1 || info_x2.numTensors < 1 || info_y.numTensors < 1) {
        std::fprintf(stderr, "[bmm] P3 expects one tensor per input/output group\n");
        return;
    }
    const TensorInfo& t1 = info_x1.tensors[0];
    const TensorInfo& t2 = info_x2.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    if (t1.numDims != 3 || t2.numDims != 3 || ty.numDims != 1) {
        std::fprintf(stderr, "[bmm] P3 expects x1/x2 rank-3 and y rank-1\n");
        return;
    }
    if (t1.dtype != 1 || t2.dtype != 1) {  // fp16 inputs only (this slice); bf16 later
        std::fprintf(stderr, "[bmm] P3 supports fp16 inputs only (got x1=%d x2=%d)\n", t1.dtype, t2.dtype);
        return;
    }
    if (ty.dtype != 0) {  // y must be fp32
        std::fprintf(stderr, "[bmm] P3 expects fp32 output (got y=%d)\n", ty.dtype);
        return;
    }
    if (transposeX1 || transposeX2) {
        std::fprintf(stderr, "[bmm] P3 supports transposeX1/transposeX2 == false only\n");
        return;
    }

    const int64_t B = t1.shape[0];
    const int64_t M = t1.shape[1];
    const int64_t K1 = t1.shape[2];
    const int64_t K2 = t2.shape[1];
    const int64_t N = t2.shape[2];
    if (t2.shape[0] != B || K1 != K2 || ty.shape[0] != B) {
        std::fprintf(stderr, "[bmm] inconsistent shapes: x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) y=(%lld)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)t2.shape[0], (long long)K2,
                     (long long)N, (long long)ty.shape[0]);
        return;
    }
    // --- P3 shape dispatch (2026-09-06) ---
    // The P2b fixed-shape guard (M,N<=64 && K%16==0) is lifted: the fused kernel
    // reduces whatever (baseM x baseN) tile the tiling library emits, so M and N
    // only need to fit the statement domain and K only needs its statement-multiple
    // of 8. M==N==1 keeps the P2a vector dot fallback (numerically exact single-
    // point product) because the Cube engine cannot execute a 1x1 tile (2026-09-05
    // cloud evidence: GetTiling OK but the Cube run dies ret=507015).
    const bool singlePoint = (M == 1 && N == 1);
    constexpr int64_t kP3MaxB = 64;
    constexpr int64_t kP3MaxDim = 8192;
    constexpr int64_t kP3MinK = 32;
    constexpr int64_t kP3MaxK = 8192;
    if (B > kP3MaxB || M > kP3MaxDim || N > kP3MaxDim || K1 < kP3MinK || K1 > kP3MaxK || (K1 % 8) != 0) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: outside statement domain x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) "
                     "(B<=%lld M,N<=%lld K in [%lld,%lld] mult of 8)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)B, (long long)K2, (long long)N,
                     (long long)kP3MaxB, (long long)kP3MaxDim, (long long)kP3MinK, (long long)kP3MaxK);
        return;
    }

    // x1/x2/y are GM_ADDR = __gm__ uint8_t*. Keep the qualifier end-to-end:
    // bisheng rejects reinterpret_cast that drops __gm__ (cloud build error on
    // 2026-09-05), so no plain-pointer alias of a GM tensor may be formed here.
    __gm__ uint8_t* x1Base = x1;
    __gm__ uint8_t* x2Base = x2;
    __gm__ uint8_t* yBase = y;

    if (singlePoint) {
        // M == N == 1: the Cube engine cannot execute a 1x1 tile (2026-09-05
        // cloud verdict — GetTiling accepts the no-SetFixSplit probe but the
        // resulting Cube run dies ret=507015), so route to the vector dot kernel.
        if (K1 % 16 != 0) {
            std::fprintf(stderr, "[bmm] P2a boundary: K=%lld is not a multiple of 16 "
                                 "(vector dot needs 32-byte-aligned segments)\n",
                         (long long)K1);
            return;
        }
        std::fprintf(stderr, "[bmm] run path: VECTOR DOT FALLBACK (1x1: B=%lld K=%lld)\n",
                     (long long)B, (long long)K1);
        bmm_batch_dot<<<1, nullptr, stream>>>(x1Base, x2Base, yBase, static_cast<int32_t>(B),
                                              static_cast<int32_t>(K1));
        return;
    }

    // ===== P3 fused path: one __mix__ core per batch, no full-C GM buffer =====
    // 2026-09-06: replaces the P2b "Cube -> temp C GM -> bmm_reduce" pipeline.
    // Each batch is handled by a single bmm_batch_fused launch whose cube engine
    // produces C tiles into UB (VECIN output, tiling vecInC=true) and whose AIV
    // units contract each tile into a running row-max in-kernel. y[b] is written
    // directly as one fp32, so the B x M x N x 4B C intermediate never exists in
    // GM (that buffer would be ~17 GB at B=64 M=N=8192 K=32).
    platform_ascendc::PlatformAscendC* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        std::fprintf(stderr, "[bmm] PlatformAscendCManager::GetInstance() returned nullptr\n");
        return;
    }

    AscendC::tiling::TCubeTiling tiling;
    if (!GenBatchMatmulTiling(platform, tiling, static_cast<int32_t>(M), static_cast<int32_t>(N),
                              static_cast<int32_t>(K1), /*vecInC=*/true)) {
        return;
    }
    // The fused kernel owns the whole batch: host launched one mix core and relies
    // on the tiling to hand that core the entire M x N domain (P4 = multi-core +
    // partial-sum merge; until then a core-splitting tiling is an honest boundary).
    if (tiling.usedCoreNum != 1 || tiling.singleCoreM != tiling.M || tiling.singleCoreN != tiling.N) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: tiling splits the batch (usedCoreNum=%d singleCore=(%d,%d) "
                     "shape=(%d,%d)); fused path needs usedCoreNum==1 + whole shape, multi-core is P4\n",
                     tiling.usedCoreNum, tiling.singleCoreM, tiling.singleCoreN, tiling.M, tiling.N);
        return;
    }
    // The fused kernel maps tiles to rows with roundM = singleCoreM/baseM and
    // folds every emitted tile's full baseM x baseN C-block into the running
    // max. A trailing partial tile (singleCoreM % baseM != 0, or singleCoreN %
    // baseN != 0) would overflow runningMax or fold padded/garbage lanes into
    // the row max, so such tilings are an honest boundary until a tail-tile
    // reduction exists. baseM/baseN == 0 would divide-by-zero in the kernel.
    if (tiling.baseM == 0 || tiling.baseN == 0 || tiling.singleCoreM % tiling.baseM != 0 ||
        tiling.singleCoreN % tiling.baseN != 0) {
        std::fprintf(stderr,
                     "[bmm] P3 boundary: fused tile does not exactly cover the shape (base=(%u,%u) "
                     "singleCore=(%u,%u) M=%u N=%u); partial-tail reduction not implemented yet\n",
                     tiling.baseM, tiling.baseN, tiling.singleCoreM, tiling.singleCoreN, tiling.M,
                     tiling.N);
        return;
    }
    std::fprintf(stderr, "[bmm] run path: FUSED REDUCE (B=%lld M=%lld N=%lld K=%lld base=(%d,%d))\n",
                 (long long)B, (long long)M, (long long)N, (long long)K1, tiling.baseM, tiling.baseN);

    const int64_t wsBytes = static_cast<int64_t>(platform->GetLibApiWorkSpaceSize());
    const int64_t biasBytes = N * static_cast<int64_t>(sizeof(float));

    uint8_t* biasDevice = nullptr;
    uint8_t* wsDevice = nullptr;
    auto aclErr = aclrtMalloc(reinterpret_cast<void**>(&biasDevice), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (aclErr == ACL_SUCCESS && wsBytes > 0) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&wsDevice), wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMalloc failed ret=%d\n", aclErr);
        if (biasDevice != nullptr) aclrtFree(biasDevice);
        if (wsDevice != nullptr) aclrtFree(wsDevice);
        return;
    }

    // bias is all zeros so C = pure batch matmul.
    if (aclrtMemsetAsync(biasDevice, biasBytes, 0, biasBytes, stream) != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMemsetAsync(bias) failed\n");
        aclrtFree(biasDevice);
        if (wsDevice != nullptr) aclrtFree(wsDevice);
        return;
    }

    // Per batch: launch one fused mix core that reduces the whole batch to y[b].
    for (int64_t b = 0; b < B; ++b) {
        __gm__ uint8_t* aBatch = x1Base + b * M * K1 * static_cast<int64_t>(sizeof(uint16_t));
        __gm__ uint8_t* bBatch = x2Base + b * K2 * N * static_cast<int64_t>(sizeof(uint16_t));
        __gm__ uint8_t* ySlot = yBase + b * static_cast<int64_t>(sizeof(float));
        bmm_batch_fused<<<1, nullptr, stream>>>(aBatch, bBatch, biasDevice, ySlot, wsDevice, tiling);
    }

    aclrtFree(biasDevice);
    if (wsDevice != nullptr) aclrtFree(wsDevice);
}

// Local test main — selects a case by argv and runs it.
// Usage: ./batch_matmul_max_sum_custom [case_id]
//   default case_id = 0. Reads ./input/case<id>/x1.bin x2.bin,
//   writes ./output/case<id>/y.bin.
//
// IMPORTANT: the case table below MUST stay in sync with scripts/gen_data.py
// (same id -> same (B,M,N,K)); tolerances live in scripts/verify_result.py.

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

// Case table: id -> (B, M, N, K). MUST match scripts/gen_data.py.
struct CaseShape { int64_t b, m, n, k; };
static const CaseShape CASE_SHAPES[] = {
    {1, 64, 64, 64},      // 0: anchor 64^3 (P2b regression)
    {1, 1, 1, 64},        // 1: single point (vector dot path)
    {8, 64, 64, 64},      // 2: batch 8
    {1, 64, 64, 40},      // 3: K=40 (8-multiple, not 16-multiple)
    {1, 1000, 64, 64},    // 4: M tail (1000 not 16-aligned)
    {1, 64, 1000, 64},    // 5: N tail (1000 not 16-aligned)
};
static const int NUM_CASES = sizeof(CASE_SHAPES) / sizeof(CASE_SHAPES[0]);

int main(int argc, char** argv)
{
    int caseId = 0;
    if (argc > 1) {
        caseId = atoi(argv[1]);
    }
    if (caseId < 0 || caseId >= NUM_CASES) {
        fprintf(stderr, "[ERROR] unknown case_id %d; valid ids: 0..%d\n", caseId, NUM_CASES - 1);
        return 1;
    }
    const int64_t CASE_B = CASE_SHAPES[caseId].b;
    const int64_t CASE_M = CASE_SHAPES[caseId].m;
    const int64_t CASE_N = CASE_SHAPES[caseId].n;
    const int64_t CASE_K = CASE_SHAPES[caseId].k;

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    // All byte sizes are derived from the shape constants so shape/buffer
    // length can never drift apart again (they were hand-coded 64/64/4 in P2a).
    // Route ③: the on-disk / device layout is the ZERO-PADDED one produced by
    // scripts/gen_data.py (Mpad = 64-row blocks, Kpad = 16-half matmul rows),
    // NOT the logical shape. run_kernel re-derives Mpad/Kpad from the tensor
    // info, so the host buffers here MUST match that padded byte count.
    const int64_t X1_BYTES = CASE_B * kPadM(CASE_M) * kPadK(CASE_K) * 2;  // fp16 bytes (padded)
    const int64_t X2_BYTES = CASE_B * kPadK(CASE_K) * CASE_N * 2;  // fp16 bytes (padded)
    const int64_t Y_BYTES = CASE_B * 4;                     // fp32 bytes

    char x1_path[256], x2_path[256], y_path[256];
    snprintf(x1_path, sizeof(x1_path), "./input/case%d/x1.bin", caseId);
    snprintf(x2_path, sizeof(x2_path), "./input/case%d/x2.bin", caseId);
    snprintf(y_path, sizeof(y_path), "./output/case%d/y.bin", caseId);

    printf("=== Running case %d: B=%lld M=%lld N=%lld K=%lld ===\n",
           caseId, (long long)CASE_B, (long long)CASE_M, (long long)CASE_N, (long long)CASE_K);

    int64_t x1_0_shape[] = {CASE_B, CASE_M, CASE_K};
    TensorInfo x1_tensors[] = {{x1_0_shape, 3, 1}};
    TensorGroupInfo info_x1 = {x1_tensors, 1};
    int64_t x2_0_shape[] = {CASE_B, CASE_K, CASE_N};
    TensorInfo x2_tensors[] = {{x2_0_shape, 3, 1}};
    TensorGroupInfo info_x2 = {x2_tensors, 1};
    int64_t y_0_shape[] = {CASE_B};
    TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};
    TensorGroupInfo info_y = {y_tensors, 1};

    bool transposeX1 = false;
    bool transposeX2 = false;

    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;

    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, X1_BYTES));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, X1_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile(x1_path, X1_BYTES, inputHost_x1, X1_BYTES));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1, X1_BYTES, inputHost_x1, X1_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, X2_BYTES));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, X2_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile(x2_path, X2_BYTES, inputHost_x2, X2_BYTES));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2, X2_BYTES, inputHost_x2, X2_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, Y_BYTES));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, Y_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
    // Wait up to 100s for the kernel stream; large-shape cases (M,N up to 8192)
    // can run much longer than the P2b 3s anchor. run.sh still guards with its
    // own `timeout 120`.
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 100000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_y, Y_BYTES, outputDevice_y, Y_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile(y_path, outputHost_y, Y_BYTES));

    if (inputDevice_x1) aclrtFree(inputDevice_x1);
    if (inputHost_x1) aclrtFreeHost(inputHost_x1);
    if (inputDevice_x2) aclrtFree(inputDevice_x2);
    if (inputHost_x2) aclrtFreeHost(inputHost_x2);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

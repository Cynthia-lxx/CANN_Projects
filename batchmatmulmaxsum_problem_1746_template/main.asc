// Local test main — manifest-driven batch runner.
// Usage: ./batch_matmul_max_sum_custom [case_id]
//   no args : run every case listed in ./input/cases.txt
//   case_id : run only that case
// For every case the binary reads ./input/case<id>/x1.bin x2.bin (LOGICAL
// row-major layout produced by scripts/gen_data.py), calls run_kernel() with
// the tensor group info built from the manifest, and writes
// ./output/case<id>/y.bin. scripts/verify_result.py then compares against the
// golden. exit code is 0 only if every requested case finished without an ACL
// / I/O error (numeric verdicts live in verify_result.py).

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include <inttypes.h>  // SCNd64: int64_t is 'long' on aarch64-linux, 'long long' on LLP64
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

// Manifest row: cid B M N K dtype tx1 tx2   (see scripts/gen_data.py)
struct ManifestCase {
    int64_t cid;
    int64_t b, m, n, k;
    int64_t dtype;  // 1=fp16 2=bf16
    int64_t tx1, tx2;
};

static int LoadCases(ManifestCase* out, int maxCases)
{
    FILE* f = fopen("./input/cases.txt", "r");
    if (f == nullptr) {
        fprintf(stderr, "[ERROR] cannot open ./input/cases.txt — run scripts/gen_data.py first\n");
        return -1;
    }
    int n = 0;
    while (n < maxCases) {
        ManifestCase c;
        if (fscanf(f, "%" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64,
                   &c.cid, &c.b, &c.m, &c.n, &c.k, &c.dtype, &c.tx1, &c.tx2) != 8) {
            break;
        }
        out[n++] = c;
    }
    fclose(f);
    return n;
}

int main(int argc, char** argv)
{
    int64_t onlyCid = -1;
    if (argc > 1) {
        onlyCid = atoll(argv[1]);
    }

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    ManifestCase cases[64];
    int ncases = LoadCases(cases, 64);
    if (ncases <= 0) {
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 1;
    }

    int overallPass = 1;
    for (int i = 0; i < ncases; ++i) {
        const ManifestCase& c = cases[i];
        if (onlyCid >= 0 && c.cid != onlyCid) {
            continue;
        }
        if (c.dtype != 1 && c.dtype != 2) {  // fp16 / bf16 only for this milestone
            fprintf(stderr, "[ERROR] case %lld: unsupported dtype %lld (this milestone: 1=fp16 2=bf16)\n",
                    (long long)c.cid, (long long)c.dtype);
            overallPass = 0;
            continue;
        }

        // LOGICAL byte counts (2 bytes/element for fp16 & bf16).
        const int64_t x1Bytes = c.b * c.m * c.k * 2;
        const int64_t x2Bytes = c.b * c.k * c.n * 2;
        const int64_t yBytes = c.b * 4;

        char x1_path[256], x2_path[256], y_path[256];
        snprintf(x1_path, sizeof(x1_path), "./input/case%lld/x1.bin", (long long)c.cid);
        snprintf(x2_path, sizeof(x2_path), "./input/case%lld/x2.bin", (long long)c.cid);
        snprintf(y_path, sizeof(y_path), "./output/case%lld/y.bin", (long long)c.cid);

        printf("=== Running case %lld: B=%lld M=%lld N=%lld K=%lld dtype=%lld bytes(x1=%lld x2=%lld y=%lld) ===\n",
               (long long)c.cid, (long long)c.b, (long long)c.m, (long long)c.n, (long long)c.k,
               (long long)c.dtype, (long long)x1Bytes, (long long)x2Bytes, (long long)yBytes);

        int64_t x1_0_shape[] = {c.b, c.m, c.k};
        TensorInfo x1_tensors[] = {{x1_0_shape, 3, (int32_t)c.dtype}};
        TensorGroupInfo info_x1 = {x1_tensors, 1};
        int64_t x2_0_shape[] = {c.b, c.k, c.n};
        TensorInfo x2_tensors[] = {{x2_0_shape, 3, (int32_t)c.dtype}};
        TensorGroupInfo info_x2 = {x2_tensors, 1};
        int64_t y_0_shape[] = {c.b};
        TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};  // y is fp32
        TensorGroupInfo info_y = {y_tensors, 1};

        uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
        uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;
        uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

        bool ok = true;
        ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, x1Bytes));
        ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ok = ReadFile(x1_path, x1Bytes, inputHost_x1, x1Bytes);
        if (!ok) { fprintf(stderr, "[ERROR] ReadFile %s failed\n", x1_path); return 1; }
        ACL_CHECK(aclrtMemcpy(inputDevice_x1, x1Bytes, inputHost_x1, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

        ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, x2Bytes));
        ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ok = ReadFile(x2_path, x2Bytes, inputHost_x2, x2Bytes);
        if (!ok) { fprintf(stderr, "[ERROR] ReadFile %s failed\n", x2_path); return 1; }
        ACL_CHECK(aclrtMemcpy(inputDevice_x2, x2Bytes, inputHost_x2, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

        ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, yBytes));
        ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, yBytes, ACL_MEM_MALLOC_HUGE_FIRST));

        // run_kernel expects plain uint8_t* device addresses (host side; it does
        // its own pad copies via ACL APIs). No GM_ADDR cast needed.
        run_kernel(inputDevice_x1, info_x1, inputDevice_x2, info_x2, outputDevice_y, info_y, availableCoreNum,
                   stream, c.tx1 != 0, c.tx2 != 0);
        auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 120000);
        if (sync_ret_ != 0) {
            fprintf(stderr, "[ERROR] case %lld aclrtSynchronizeStreamWithTimeout failed, ret=%d\n",
                    (long long)c.cid, sync_ret_);
            overallPass = 0;
        } else {
            ACL_CHECK(aclrtMemcpy(outputHost_y, yBytes, outputDevice_y, yBytes, ACL_MEMCPY_DEVICE_TO_HOST));
            if (!WriteFile(y_path, outputHost_y, yBytes)) {
                fprintf(stderr, "[ERROR] WriteFile %s failed\n", y_path);
                return 1;
            }
            printf("=== case %lld done ===\n", (long long)c.cid);
        }

        if (inputDevice_x1) aclrtFree(inputDevice_x1);
        if (inputHost_x1) aclrtFreeHost(inputHost_x1);
        if (inputDevice_x2) aclrtFree(inputDevice_x2);
        if (inputHost_x2) aclrtFreeHost(inputHost_x2);
        if (outputDevice_y) aclrtFree(outputDevice_y);
        if (outputHost_y) aclrtFreeHost(outputHost_y);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return overallPass ? 0 : 1;
}

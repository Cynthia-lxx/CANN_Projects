/*
 * BatchMatmulMaxSum (problem_1746) — M1 vertical slice, Ascend C Direct Invocation.
 * This file is #included by main.asc — do NOT add main(), #pragma once or include
 * guards.
 *
 * Semantics: y[b] = sum_m max_n ( sum_k x1[b,m,k] * x2[b,k,n] ),
 *            x1/x2 fp16|bf16, y fp32, dtype==transposeX1==transposeX2==false.
 *
 * M1 design (2026-09-06, independent derivation; cross-checked against the
 * packaged cann_ascendc_headers_9.0.0 and the light-03.03 matmul skeleton):
 *   * Input binaries are in LOGICAL row-major layout ((B,M,K) and (B,K,N)),
 *     identical to what the judge injects. All zero padding happens inside this
 *     file (host side of run_kernel), never in the data files.
 *   * run_kernel pads once per call into GM scratch:
 *        x1pad : (B, Mpad, Kpad)   Mpad = ceil(M/64)*64, Kpad = ceil(K/16)*16
 *        x2pad : (B, Kpad, Npad)   Npad = ceil(N/64)*64  (row width of C tiles)
 *     Pad rows/cols are EXACTLY 0 (full aclrtMemsetAsync zero + real-region row
 *     copies), so they contribute exactly 0 to every fp32 reduction.
 *   * Cube pipeline per (batch, 64-row M block), one launch each on stream:
 *        bmm_cube_<fp16|bf16>:  64 x Npad x Kpad  -> C tile (64 x Npad fp32)
 *        bmm_tile_reduce:       row maxima over the REAL N columns, summed over
 *                               the REAL rows of the block -> one fp32 partial
 *        bmm_part_sum:          adds the padded block partials into y[b]
 *     The reduce direction (row max over N first, then sum over M) follows the
 *     2026-09-06 lesson: the reverse order is numerically wrong.
 *   * Row maxima start from -FLT_MAX (NOT 0) so fully negative rows return their
 *     true maximum (problem constraint). Padded columns (C == 0) are excluded by
 *     counting only realCols lanes in ReduceMax.
 *   * M==N==1 is NOT special-cased: padding turns it into an ordinary
 *     64 x Npad x Kpad cube tile (the 1x1 raw shape is the only one the Cube
 *     engine refuses, P2a 2026-09-05 evidence).
 *   * Honest boundaries: out-of-domain shapes, transpose!=false, dtype!=fp16/bf16
 *     or a workspace/copy budget that M1's per-batch scratch cannot hold are
 *     printed to stderr and returned without launching anything.
 *
 * Head facts used here (verified 2026-09-06 against cann_ascendc_headers_9.0.0):
 *   - ReduceMax Level-2 count form:
 *       ReduceMax(dst, src, sharedTmpBuffer, count, calIndex=0)
 *     on 2201 it is a single-repeat whole-reduce; fp32 elementNumPerRep = 64 so
 *     count <= 64 (any remainder is masked to count lanes).
 *   - ReduceSum level-2 count form: ReduceSum<T, isReuse>(dst, src, tmp, count).
 *   - Cast count form: Cast(dst, src, roundMode, count); fp16/bf16 -> fp32 uses
 *     RoundMode::CAST_NONE.
 *   - DataCopy/LocalTensor count form needs a 32B multiple; our C-tile rows are
 *     Npad%64==0 floats wide, so every 64-float segment is 256B aligned.
 *   - ASCENDC_CUBE_ONLY MUST be defined before including lib/matmul_intf.h:
 *     under SPLIT_CORE_CUBE the REGIST_MATMUL_OBJ expands to a KfcServer loop
 *     unless this macro flips it to InitCurObj (ret=507015 otherwise).
 */

#include <cstdint>
#include <cstdio>
#include <cfloat>
#include <climits>

#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

namespace {

// ---------------------------------------------------------------------------
// Pad helpers shared by run_kernel (host) and main.asc buffer math.
// M pad: 64-row bounded-C block.  K pad: cube K granularity 16.
// N pad: 64 floats so every C-tile row read is 64-float segments (256B).
// ---------------------------------------------------------------------------
constexpr int64_t kBlockRows = 64;
constexpr int64_t kKAlign = 16;
constexpr int64_t kNAlign = 64;

inline int64_t PadUp(int64_t v, int64_t a)
{
    const int64_t r = v % a;
    return (r == 0) ? v : (v + (a - r));
}
inline int64_t Mpadded(int64_t m) { return PadUp(m, kBlockRows); }
inline int64_t Kpadded(int64_t k) { return PadUp(k, kKAlign); }
inline int64_t Npadded(int64_t n) { return PadUp(n, kNAlign); }
inline int64_t BlockCount(int64_t m) { return Mpadded(m) / kBlockRows; }

// Per-batch scratch budget for this slice (smoke shapes are far below it).
constexpr int64_t kMaxPadBytes = 1LL << 30;   // 1 GiB combined x1pad+x2pad+C
constexpr int64_t kMaxRowCopies = 1 << 18;    // host row memcpy count

// ---------------------------------------------------------------------------
// Deterministic tiling probe ladder for matmul_tiling::SetFixSplit(). Every
// candidate uses a FRESH MultiCoreMatmulTiling (the object is single-use) and
// identical options apart from the split; the first probe with a valid
// TCubeTiling wins. v1 (no SetFixSplit at all) is expected to win on the
// bounded blocks; the fixed-split entries remain as fallbacks.
// ---------------------------------------------------------------------------
struct TileProbe {
    const char* name;
    bool useFix;  // false -> SetFixSplit() is never called
    int32_t baseM;
    int32_t baseN;
};

bool ProbeDuplicated(const TileProbe* ladder, int32_t len, const TileProbe& cand)
{
    for (int32_t i = 0; i < len; ++i) {
        if (!ladder[i].useFix) {
            if (!cand.useFix) {
                return true;
            }
            continue;
        }
        if (cand.useFix && ladder[i].baseM == cand.baseM && ladder[i].baseN == cand.baseN) {
            return true;
        }
    }
    return false;
}

void PushProbe(TileProbe* ladder, int32_t* len, const TileProbe& cand)
{
    if (!ProbeDuplicated(ladder, *len, cand)) {
        ladder[(*len)++] = cand;
    }
}

bool GenBlockTiling(platform_ascendc::PlatformAscendC* platform, matmul_tiling::DataType aType,
                    const char* typeTag, AscendC::tiling::TCubeTiling& tiling, int32_t m, int32_t n,
                    int32_t k)
{
    const int32_t adM = (m < 128) ? m : 128;
    const int32_t adN = (n < 128) ? n : 128;

    constexpr int32_t kMaxProbes = 8;
    TileProbe ladder[kMaxProbes];
    int32_t ladderLen = 0;

    PushProbe(ladder, &ladderLen, {"official SetFixSplit(128,128)", true, 128, 128});
    PushProbe(ladder, &ladderLen, {"no SetFixSplit", false, 0, 0});
    PushProbe(ladder, &ladderLen, {"adaptive SetFixSplit(min(shape,128))", true, adM, adN});
    PushProbe(ladder, &ladderLen, {"SetFixSplit(16,16)", true, 16, 16});
    PushProbe(ladder, &ladderLen, {"SetFixSplit(8,8)", true, 8, 8});
    PushProbe(ladder, &ladderLen, {"SetFixSplit(1,1)", true, 1, 1});

    for (int32_t p = 0; p < ladderLen; ++p) {
        const TileProbe& pr = ladder[p];
        matmul_tiling::MultiCoreMatmulTiling probe(*platform);
        probe.SetDim(1);  // one cube core for the whole 64 x N block
        probe.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, aType);
        probe.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, aType);
        probe.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT);
        probe.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                          matmul_tiling::DataType::DT_FLOAT);
        probe.SetShape(m, n, k);
        probe.SetOrgShape(m, n, k);
        if (pr.useFix) {
            probe.SetFixSplit(pr.baseM, pr.baseN, -1);
        }
        probe.SetBias(true);
        probe.SetBufferSpace(-1, -1, -1);
        if (probe.GetTiling(tiling) == -1) {
            std::fprintf(stderr, "[bmm] %s probe %s: FAILED\n", typeTag, pr.name);
            continue;
        }
        // Accept only a tiling that keeps the WHOLE 64 x N block on one cube
        // core with the padded row width Kpad (our GM slices are contiguous
        // row-major with exactly that layout). Any split/mismatch falls through
        // to the next probe instead of aborting the whole run.
        if (tiling.usedCoreNum != 1 || tiling.M != m || tiling.N != n || tiling.singleCoreM != tiling.M ||
            tiling.singleCoreN != tiling.N || tiling.Ka != k || tiling.Kb != k) {
            std::fprintf(stderr,
                         "[bmm] %s probe %s: rejected (usedCores=%d M=%d N=%d singleCore=(%d,%d) "
                         "Ka/Kb=%d/%d != Kpad=%d)\n",
                         typeTag, pr.name, tiling.usedCoreNum, tiling.M, tiling.N, tiling.singleCoreM,
                         tiling.singleCoreN, tiling.Ka, tiling.Kb, k);
            continue;
        }
        std::fprintf(stderr, "[bmm] %s probe %s: OK tiling M=%d N=%d Ka=%d Kb=%d "
                             "base(M=%d,N=%d) usedCores=%d\n",
                     typeTag, pr.name, tiling.M, tiling.N, tiling.Ka, tiling.Kb, tiling.baseM, tiling.baseN,
                     tiling.usedCoreNum);
        return true;
    }

    std::fprintf(stderr, "[bmm] %s tiling failed for M=%d N=%d K=%d after %d probes\n", typeTag, m, n, k,
                 ladderLen);
    return false;
}

}  // namespace

// ---------------------------------------------------------------------------
// Cube: C(64 x N) = x1padBlock(64 x K) x x2pad(K x N), fp16 x fp16 -> fp32.
// The block pointer already points at the block's 64 padded rows of one batch.
// Shape and row widths come from `tiling` (M==64, N==Npad, Ka==Kb==Kpad).
// ---------------------------------------------------------------------------
__global__ __cube__ void bmm_cube_fp16(__gm__ uint8_t* aPad, __gm__ uint8_t* bPad, __gm__ uint8_t* bias,
                                       __gm__ uint8_t* cTile, __gm__ uint8_t* workspace,
                                       AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aG;
    AscendC::GlobalTensor<half> bG;
    AscendC::GlobalTensor<float> biasG;
    AscendC::GlobalTensor<float> cG;

    aG.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(aPad), tiling.M * tiling.Ka);
    bG.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(bPad), tiling.Kb * tiling.N);
    biasG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cTile), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aG);
    mm.SetTensorB(bG);
    mm.SetBias(biasG);
    mm.IterateAll(cG);
    mm.End();
}

// ---------------------------------------------------------------------------
// bf16 twin: identical pipeline, input element type bfloat16_t.
// ---------------------------------------------------------------------------
__global__ __cube__ void bmm_cube_bf16(__gm__ uint8_t* aPad, __gm__ uint8_t* bPad, __gm__ uint8_t* bias,
                                       __gm__ uint8_t* cTile, __gm__ uint8_t* workspace,
                                       AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<bfloat16_t> aG;
    AscendC::GlobalTensor<bfloat16_t> bG;
    AscendC::GlobalTensor<float> biasG;
    AscendC::GlobalTensor<float> cG;

    aG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(aPad), tiling.M * tiling.Ka);
    bG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(bPad), tiling.Kb * tiling.N);
    biasG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cTile), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, bfloat16_t>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, bfloat16_t>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aG);
    mm.SetTensorB(bG);
    mm.SetBias(biasG);
    mm.IterateAll(cG);
    mm.End();
}

// ---------------------------------------------------------------------------
// Vector: contract ONE C tile (64 rows x nPad cols) into a single fp32 partial.
//   partial = sum_{r < realRows}  max over the real N columns of tile row r.
// Reads are aligned because nPad%64==0: every segment is exactly 64 floats
// (256B). The last segment may contain padded columns (value 0); ReduceMax only
// counts realCols lanes so zeros never leak into a row maximum. Fully negative
// rows are handled by the -FLT_MAX identity (never 0).
// ---------------------------------------------------------------------------
__global__ __vector__ void bmm_tile_reduce(__gm__ uint8_t* cTile, __gm__ uint8_t* partOut,
                                           int32_t realRows, int32_t realCols, int32_t nPad)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    constexpr int32_t kSeg = 64;  // fp32 lanes per whole-reduce repeat

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufRowMax;

    pipe.InitBuffer(inQ, 1, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufRowMax, kSeg * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();
    LocalTensor<float> rowMax = bufRowMax.Get<float>();

    LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, static_cast<float>(0), kSeg);  // acc[0] = 0.0f

    __gm__ float* cBase = reinterpret_cast<__gm__ float*>(cTile);
    for (int32_t r = 0; r < realRows; ++r) {
        // Row-max identity: -FLT_MAX (no zero init, problem constraint).
        AscendC::Duplicate(rowMax, -3.4028234663852886e+38f, kSeg);
        const int32_t rowBase = r * nPad;
        int32_t col = 0;
        while (col < nPad) {
            // Whole 64-float segment copy (nPad%64==0 keeps everything aligned).
            LocalTensor<float> chunk = inQ.AllocTensor<float>();
            AscendC::GlobalTensor<float> segG;
            segG.SetGlobalBuffer(cBase + rowBase + col, kSeg);
            AscendC::DataCopy(chunk, segG, kSeg);
            inQ.EnQue(chunk);

            chunk = inQ.DeQue<float>();
            // Mask out padded columns: only realCols lanes count.
            int32_t cnt = realCols - col;
            if (cnt > kSeg) {
                cnt = kSeg;
            }
            if (cnt > 0) {
                AscendC::ReduceMax(part, chunk, tmp, cnt);  // part[0] = max over segment
                AscendC::Max(rowMax, rowMax, part, 1);      // rowMax[0] = max(rowMax[0], part[0])
            }
            inQ.FreeTensor(chunk);
            col += kSeg;
        }
        AscendC::Add(acc, acc, rowMax, 1);  // acc[0] += row maximum
    }

    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();

    __gm__ float* partPtr = reinterpret_cast<__gm__ float*>(partOut);
    AscendC::GlobalTensor<float> partSeg;
    partSeg.SetGlobalBuffer(partPtr, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(partSeg, acc, outParams);
    outQ.FreeTensor(acc);
}

// ---------------------------------------------------------------------------
// Vector: sum count fp32 partials (count = padded per-batch partial count,
// multiple of 8, buffer pre-zeroed past real partials) into ySlot.
// ---------------------------------------------------------------------------
__global__ __vector__ void bmm_part_sum(__gm__ uint8_t* partIn, __gm__ uint8_t* ySlot, int32_t count)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    constexpr int32_t kSeg = 64;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufPart;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufTmp;

    pipe.InitBuffer(inQ, 1, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(outQ, 1, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufPart, kSeg * static_cast<int32_t>(sizeof(float)));
    pipe.InitBuffer(bufTmp, kSeg * static_cast<int32_t>(sizeof(float)));

    LocalTensor<float> part = bufPart.Get<float>();
    LocalTensor<float> tmp = bufTmp.Get<float>();

    LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, static_cast<float>(0), kSeg);

    __gm__ float* inBase = reinterpret_cast<__gm__ float*>(partIn);
    int32_t off = 0;
    while (off < count) {
        const int32_t seg = (count - off < kSeg) ? (count - off) : kSeg;  // %8==0 (count%8==0)

        LocalTensor<float> chunk = inQ.AllocTensor<float>();
        AscendC::GlobalTensor<float> segG;
        segG.SetGlobalBuffer(inBase + off, seg);
        AscendC::DataCopy(chunk, segG, seg);
        inQ.EnQue(chunk);

        chunk = inQ.DeQue<float>();
        AscendC::ReduceSum<float, true>(part, chunk, tmp, seg);  // chunk sum -> part[0]
        AscendC::Add(acc, acc, part, 1);                          // acc[0] += part[0]
        inQ.FreeTensor(chunk);
        off += seg;
    }

    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();

    __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(ySlot);
    AscendC::GlobalTensor<float> ySeg;
    ySeg.SetGlobalBuffer(yPtr, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(ySeg, acc, outParams);
    outQ.FreeTensor(acc);
}

// ---------------------------------------------------------------------------
// Host-side entry point. Launches are async on `stream`; the caller syncs via
// aclrtSynchronizeStreamWithTimeout before reading y (see main.asc), and this
// function syncs again before freeing its own scratch buffers.
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    (void)availableCoreNum;

    // ---- shape / dtype guards (honest boundaries) ------------------------
    if (info_x1.numTensors < 1 || info_x2.numTensors < 1 || info_y.numTensors < 1) {
        std::fprintf(stderr, "[bmm] expected one tensor per input/output group\n");
        return;
    }
    const TensorInfo& t1 = info_x1.tensors[0];
    const TensorInfo& t2 = info_x2.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    if (t1.numDims != 3 || t2.numDims != 3 || ty.numDims != 1) {
        std::fprintf(stderr, "[bmm] expected x1/x2 rank-3 and y rank-1\n");
        return;
    }
    const bool isBf16 = (t1.dtype == 2);
    if (!(t1.dtype == 1 || isBf16) || t1.dtype != t2.dtype) {
        std::fprintf(stderr, "[bmm] M1 supports fp16/bf16 inputs only (x1=%d x2=%d)\n", t1.dtype, t2.dtype);
        return;
    }
    if (ty.dtype != 0) {
        std::fprintf(stderr, "[bmm] M1 expects fp32 output (y=%d)\n", ty.dtype);
        return;
    }
    if (transposeX1 || transposeX2) {
        std::fprintf(stderr, "[bmm] M1 supports transposeX1/transposeX2 == false only\n");
        return;
    }

    const int64_t B = t1.shape[0];
    const int64_t M = t1.shape[1];
    const int64_t K1 = t1.shape[2];
    const int64_t K2 = t2.shape[1];
    const int64_t N = t2.shape[2];
    if (t2.shape[0] != B || K1 != K2 || ty.shape[0] != B) {
        std::fprintf(stderr, "[bmm] inconsistent shapes x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) y=(%lld)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)t2.shape[0], (long long)K2,
                     (long long)N, (long long)ty.shape[0]);
        return;
    }
    if (B <= 0 || B > 64 || M <= 0 || M > 8192 || N <= 0 || N > 8192 || K1 < 32 || K1 > 8192 || (K1 % 8) != 0) {
        std::fprintf(stderr,
                     "[bmm] domain boundary: x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld) "
                     "(B<=64 M,N<=8192 K in [32,8192] mult of 8)\n",
                     (long long)B, (long long)M, (long long)K1, (long long)t2.shape[0], (long long)K2, (long long)N);
        return;
    }

    __gm__ uint8_t* x1Base = x1;
    __gm__ uint8_t* x2Base = x2;
    __gm__ uint8_t* yBase = y;

    const int64_t Mpad = Mpadded(M);
    const int64_t Kpad = Kpadded(K1);
    const int64_t Npad = Npadded(N);
    const int64_t blocks = BlockCount(M);
    const int64_t partPad = ((blocks + 7) / 8) * 8;  // padded partial count (mult of 8)

    // Budget guard for this slice: host row-copy count and scratch bytes.
    const int64_t rowCopies = B * (M + K1);
    const int64_t aPadBytes = B * Mpad * Kpad * static_cast<int64_t>(2);
    const int64_t bPadBytes = B * Kpad * Npad * static_cast<int64_t>(2);
    const int64_t cTileBytes = kBlockRows * Npad * static_cast<int64_t>(sizeof(float));
    if (rowCopies > kMaxRowCopies || (aPadBytes + bPadBytes + cTileBytes) > kMaxPadBytes) {
        std::fprintf(stderr,
                     "[bmm] M1 budget boundary: rowCopies=%lld aPad=%lldB bPad=%lldB C=%lldB "
                     "(large-shape K-splitting is a later milestone)\n",
                     (long long)rowCopies, (long long)aPadBytes, (long long)bPadBytes, (long long)cTileBytes);
        return;
    }

    platform_ascendc::PlatformAscendC* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        std::fprintf(stderr, "[bmm] PlatformAscendCManager::GetInstance() returned nullptr\n");
        return;
    }

    // One tiling for every 64-row block of every batch (all share shape 64 x Npad x Kpad).
    AscendC::tiling::TCubeTiling tiling;
    const matmul_tiling::DataType aType =
        isBf16 ? matmul_tiling::DataType::DT_BF16 : matmul_tiling::DataType::DT_FLOAT16;
    const char* typeTag = isBf16 ? "bf16" : "fp16";
    if (!GenBlockTiling(platform, aType, typeTag, tiling, static_cast<int32_t>(kBlockRows),
                        static_cast<int32_t>(Npad), static_cast<int32_t>(Kpad))) {
        return;
    }
    // The cube kernel reads its slices as contiguous row-major with row length
    // Ka/Kb == Kpad and expects a full 64 x Npad tile on one core.
    if (tiling.Ka != static_cast<int32_t>(Kpad) || tiling.Kb != static_cast<int32_t>(Kpad)) {
        std::fprintf(stderr, "[bmm] tiling K view Ka=%d Kb=%d != Kpad=%lld; abort\n", tiling.Ka, tiling.Kb,
                     (long long)Kpad);
        return;
    }
    if (tiling.usedCoreNum != 1 || tiling.M != static_cast<int32_t>(kBlockRows) ||
        tiling.N != static_cast<int32_t>(Npad) || tiling.singleCoreM != tiling.M ||
        tiling.singleCoreN != tiling.N) {
        std::fprintf(stderr,
                     "[bmm] tiling splits the 64xN block (usedCores=%d M=%d N=%d singleCore=(%d,%d)); abort\n",
                     tiling.usedCoreNum, tiling.M, tiling.N, tiling.singleCoreM, tiling.singleCoreN);
        return;
    }

    const int64_t wsBytes = static_cast<int64_t>(platform->GetLibApiWorkSpaceSize());
    const int64_t biasBytes = Npad * static_cast<int64_t>(sizeof(float));
    const int64_t partBytes = B * partPad * static_cast<int64_t>(sizeof(float));

    uint8_t* aPadDev = nullptr;
    uint8_t* bPadDev = nullptr;
    uint8_t* biasDev = nullptr;
    uint8_t* cTileDev = nullptr;
    uint8_t* wsDev = nullptr;
    uint8_t* partDev = nullptr;
    auto aclErr = aclrtMalloc(reinterpret_cast<void**>(&aPadDev), aPadBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&bPadDev), bPadBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&biasDev), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&cTileDev), cTileBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS && wsBytes > 0) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&wsDev), wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr == ACL_SUCCESS) {
        aclErr = aclrtMalloc(reinterpret_cast<void**>(&partDev), partBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    if (aclErr != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMalloc failed ret=%d\n", aclErr);
        if (aPadDev != nullptr) aclrtFree(aPadDev);
        if (bPadDev != nullptr) aclrtFree(bPadDev);
        if (biasDev != nullptr) aclrtFree(biasDev);
        if (cTileDev != nullptr) aclrtFree(cTileDev);
        if (wsDev != nullptr) aclrtFree(wsDev);
        if (partDev != nullptr) aclrtFree(partDev);
        return;
    }

    // Zero everything first: pad rows/cols must be exactly 0.
    if (aclrtMemsetAsync(reinterpret_cast<void*>(aPadDev), aPadBytes, 0, aPadBytes, stream) != ACL_SUCCESS ||
        aclrtMemsetAsync(reinterpret_cast<void*>(bPadDev), bPadBytes, 0, bPadBytes, stream) != ACL_SUCCESS ||
        aclrtMemsetAsync(reinterpret_cast<void*>(biasDev), biasBytes, 0, biasBytes, stream) != ACL_SUCCESS ||
        aclrtMemsetAsync(reinterpret_cast<void*>(partDev), partBytes, 0, partBytes, stream) != ACL_SUCCESS) {
        std::fprintf(stderr, "[bmm] aclrtMemsetAsync failed\n");
        aclrtFree(aPadDev);
        aclrtFree(bPadDev);
        aclrtFree(biasDev);
        aclrtFree(cTileDev);
        if (wsDev != nullptr) aclrtFree(wsDev);
        aclrtFree(partDev);
        return;
    }

    // Copy the real logical regions row by row (device-to-device, ordered on the
    // same stream). x1pad row m: Kpad halves starting at Mpad stride per row.
    for (int64_t b = 0; b < B; ++b) {
        const int64_t aBatchBase = b * (Mpad * Kpad) * static_cast<int64_t>(2);
        for (int64_t m = 0; m < M; ++m) {
            const int64_t srcOff = (b * M + m) * K1 * static_cast<int64_t>(2);
            const int64_t dstOff = aBatchBase + m * Kpad * static_cast<int64_t>(2);
            aclrtMemcpyAsync(reinterpret_cast<void*>(aPadDev + dstOff), K1 * static_cast<int64_t>(2),
                             reinterpret_cast<void*>(x1Base + srcOff), K1 * static_cast<int64_t>(2),
                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream);
        }
    }
    for (int64_t b = 0; b < B; ++b) {
        const int64_t bBatchBase = b * (Kpad * Npad) * static_cast<int64_t>(2);
        for (int64_t k = 0; k < K1; ++k) {
            const int64_t srcOff = (b * K1 + k) * N * static_cast<int64_t>(2);
            const int64_t dstOff = bBatchBase + k * Npad * static_cast<int64_t>(2);
            aclrtMemcpyAsync(reinterpret_cast<void*>(bPadDev + dstOff), N * static_cast<int64_t>(2),
                             reinterpret_cast<void*>(x2Base + srcOff), N * static_cast<int64_t>(2),
                             ACL_MEMCPY_DEVICE_TO_DEVICE, stream);
        }
    }

    std::fprintf(stderr,
                 "[bmm] run %s path: B=%lld M=%lld N=%lld K=%lld -> Mpad=%lld Kpad=%lld Npad=%lld "
                 "blocks=%lld partPad=%lld base=(%d,%d) copies=%lld\n",
                 typeTag, (long long)B, (long long)M, (long long)N, (long long)K1, (long long)Mpad,
                 (long long)Kpad, (long long)Npad, (long long)blocks, (long long)partPad, tiling.baseM,
                 tiling.baseN, (long long)rowCopies);

    const int64_t aRowBytes = Kpad * static_cast<int64_t>(2);       // bytes per padded row
    const int64_t aBatchBytes = Mpad * Kpad * static_cast<int64_t>(2);
    const int64_t bBatchBytes = Kpad * Npad * static_cast<int64_t>(2);

    for (int64_t b = 0; b < B; ++b) {
        __gm__ uint8_t* bPadBatch = bPadDev + b * bBatchBytes;
        __gm__ uint8_t* ySlot = yBase + b * static_cast<int64_t>(sizeof(float));
        __gm__ uint8_t* partBase = partDev + b * partPad * static_cast<int64_t>(sizeof(float));

        for (int64_t blk = 0; blk < blocks; ++blk) {
            int64_t realRows = M - blk * kBlockRows;
            if (realRows > kBlockRows) {
                realRows = kBlockRows;
            }
            __gm__ uint8_t* aBlock = aPadDev + b * aBatchBytes + blk * kBlockRows * aRowBytes;

            if (isBf16) {
                bmm_cube_bf16<<<1, nullptr, stream>>>(aBlock, bPadBatch, biasDev, cTileDev, wsDev, tiling);
            } else {
                bmm_cube_fp16<<<1, nullptr, stream>>>(aBlock, bPadBatch, biasDev, cTileDev, wsDev, tiling);
            }
            bmm_tile_reduce<<<1, nullptr, stream>>>(cTileDev, partBase + blk * static_cast<int64_t>(sizeof(float)),
                                                    static_cast<int32_t>(realRows), static_cast<int32_t>(N),
                                                    static_cast<int32_t>(Npad));
        }
        bmm_part_sum<<<1, nullptr, stream>>>(partBase, ySlot, static_cast<int32_t>(partPad));
    }

    // Everything above is async; free the scratch only after the stream drains.
    aclrtSynchronizeStream(stream);

    aclrtFree(aPadDev);
    aclrtFree(bPadDev);
    aclrtFree(biasDev);
    aclrtFree(cTileDev);
    if (wsDev != nullptr) aclrtFree(wsDev);
    aclrtFree(partDev);
}

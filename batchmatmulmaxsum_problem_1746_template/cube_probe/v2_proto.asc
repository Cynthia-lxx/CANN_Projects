// Probe F7 (v2_proto): end-to-end v2 pipeline prototype for batch_matmul_max_sum.
//
// Two-phase design adopted after F-series evidence:
//   * Phase 1 (reliable): pure-cube __cube__ + ASCENDC_CUBE_ONLY + IterateAll GM-C
//     computes the FULL C of one batch (M x N fp32) into a GM workspace buffer.
//     Proven exactly correct for every valid shape by F5 (incl tail N=1000, K=200).
//   * Phase 2: a plain vector kernel reads that C and computes the operator
//     semantics y[b] = sum_m (max_n C[m][n]) with the exact fp32 sequential-add /
//     -FLT_MAX / 64-chunk idiom already validated in v1 kernel.asc.
// GetTensorC -> vector consume is NOT used (cube_probe modes 0-3 proved it is a
// run-to-run race on dav-2201 / CANN 9.0.0).
//
// Same-TU note: ASCENDC_CUBE_ONLY only switches the Matmul object instantiation to
// the cube-side client; plain vector ops/queues in the second kernel are unaffected.
//
// Data: A[m][k]=m+1, B[k][n]=n+1 (fp16), bias tensor = 0 (operator has NO bias in
// the real interface; golden C = K*(m+1)*(n+1)). Per batch: cube -> C workspace ->
// reduce -> y[b]. Host verifies each y[b] against an fp64 golden.
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                         __code);                                                                       \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)

AscendC::tiling::TCubeTiling GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform, int32_t M, int32_t N,
                                            int32_t K)
{
    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(1);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(128, 128, -1);
    cubeTiling.SetBias(true);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr, "Generate matmul tiling failed (M=%d N=%d K=%d).\n", M, N, K);
    }
    return cubeTilingData;
}

// ---- Phase 1 kernel: pure-cube full-C (single block), F5-verified spelling. ----
__global__ __cube__ void v2_cube(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c,
                                 __gm__ uint8_t* workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);
    mm.IterateAll(cGlobal);
    mm.End();
}

// ---- Phase 2 kernel: y = sum_m max_n C[m][n] from an fp32 GM C. ----
// Single block; exact idiom (queues/ReduceMax/Max/Add lane-0 folds and the masked
// 4-byte DataCopyPad store) is copied from the cloud-validated v1 kernel.asc.
constexpr uint32_t kVec2 = 64;

__global__ __aicore__ void v2_reduce(__gm__ uint8_t* cPtr, __gm__ uint8_t* yPtr, int64_t mCnt, int64_t nCnt)
{
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ;
    pipe.InitBuffer(inQ, 1, kVec2 * static_cast<uint32_t>(sizeof(float)));
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(outQ, 1, kVec2 * static_cast<uint32_t>(sizeof(float)));
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPart;
    pipe.InitBuffer(bPart, kVec2 * static_cast<uint32_t>(sizeof(float)));
    AscendC::TBuf<AscendC::TPosition::VECCALC> bTmp;
    pipe.InitBuffer(bTmp, kVec2 * static_cast<uint32_t>(sizeof(float)));
    AscendC::TBuf<AscendC::TPosition::VECCALC> bRm;
    pipe.InitBuffer(bRm, kVec2 * static_cast<uint32_t>(sizeof(float)));

    AscendC::LocalTensor<float> part = bPart.Get<float>();
    AscendC::LocalTensor<float> tmp = bTmp.Get<float>();
    AscendC::LocalTensor<float> rm = bRm.Get<float>();
    __gm__ float* cBase = reinterpret_cast<__gm__ float*>(cPtr);
    __gm__ float* yBase = reinterpret_cast<__gm__ float*>(yPtr);
    AscendC::DataCopyPadExtParams<float> padParams;

    AscendC::LocalTensor<float> acc = outQ.AllocTensor<float>();
    AscendC::Duplicate(acc, 0.0f, kVec2);  // acc[0] = 0

    for (int64_t m = 0; m < mCnt; ++m) {
        __gm__ float* cRow = cBase + m * nCnt;
        AscendC::Duplicate(rm, -3.4028234663852886e38f, kVec2);  // rm[0] = -FLT_MAX
        for (int64_t c0 = 0; c0 < nCnt; c0 += static_cast<int64_t>(kVec2)) {
            const int64_t cnt = (nCnt - c0 < static_cast<int64_t>(kVec2)) ? (nCnt - c0) : static_cast<int64_t>(kVec2);
            AscendC::LocalTensor<float> raw = inQ.AllocTensor<float>();
            AscendC::GlobalTensor<float> gSeg;
            gSeg.SetGlobalBuffer(cRow + c0, static_cast<uint64_t>(nCnt - c0));
            AscendC::DataCopyExtParams dp{1, static_cast<uint32_t>(cnt * static_cast<int64_t>(sizeof(float))), 0, 0, 0};
            AscendC::DataCopyPad(raw, gSeg, dp, padParams);
            inQ.EnQue(raw);
            AscendC::LocalTensor<float> rawIn = inQ.DeQue<float>();
            AscendC::ReduceMax(part, rawIn, tmp, static_cast<uint32_t>(cnt));
            inQ.FreeTensor(rawIn);
            AscendC::Max(rm, rm, part, 1);
        }
        AscendC::Add(acc, acc, rm, 1);
    }

    outQ.EnQue(acc);
    acc = outQ.DeQue<float>();
    AscendC::GlobalTensor<float> yG;
    yG.SetGlobalBuffer(yBase, 1);
    AscendC::DataCopyExtParams outParams{1, 4, 0, 0, 0};  // exactly 4 bytes
    AscendC::DataCopyPad(yG, acc, outParams);
    outQ.FreeTensor(acc);
}

struct ProtoCase {
    const char* tag;
    int32_t M;
    int32_t N;
    int32_t K;
    int32_t B;
};

int32_t main(int32_t argc, char** argv)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr) {
        std::fprintf(stderr, "ascendcPlatform null.\n");
        return 1;
    }
    const size_t workspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());

    const ProtoCase cases[] = {
        {"M256 N640 K256 B2", 256, 640, 256, 2},
        {"M128 N1000 K200 B3 (tailN/Ktail)", 128, 1000, 200, 3},
        {"M1024 N320 K256 B1", 1024, 320, 256, 1},
        {"M512 N1000 K256 B2", 512, 1000, 256, 2},
    };
    constexpr uint32_t numCases = sizeof(cases) / sizeof(cases[0]);

    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    std::printf("v2_proto: pure-cube full-C (workspace) + v1 vector rowmax/sum reduce, unbiased. F7 run.\n");
    for (uint32_t ci = 0; ci < numCases; ++ci) {
        const ProtoCase& cs = cases[ci];
        const uint32_t M = static_cast<uint32_t>(cs.M);
        const uint32_t N = static_cast<uint32_t>(cs.N);
        const uint32_t K = static_cast<uint32_t>(cs.K);
        const uint32_t B = static_cast<uint32_t>(cs.B);

        auto tiling = GenerateTiling(ascendcPlatform, cs.M, cs.N, cs.K);
        if (tiling.M != cs.M || tiling.N != cs.N) {
            std::printf("[F7] %-28s -> TILING_FAIL (skipped)\n", cs.tag);
            continue;
        }
        const size_t aFileSize = static_cast<size_t>(B) * M * K * sizeof(aclFloat16);
        const size_t bFileSize = static_cast<size_t>(B) * K * N * sizeof(aclFloat16);
        const size_t biasFileSize = static_cast<size_t>(N) * sizeof(float);
        const size_t cFileSize = static_cast<size_t>(M) * N * sizeof(float);
        const size_t yFileSize = static_cast<size_t>(B) * sizeof(float);

        uint8_t* aDev = nullptr;
        uint8_t* bDev = nullptr;
        uint8_t* biasDev = nullptr;
        uint8_t* cDev = nullptr;
        uint8_t* yDev = nullptr;
        uint8_t* wsDev = nullptr;
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&aDev), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&bDev), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&biasDev), biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&cDev), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&yDev), yFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        if (workspaceSize > 0) {
            CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&wsDev), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST));
        }

        std::vector<aclFloat16> aHost(static_cast<size_t>(B) * M * K);
        std::vector<aclFloat16> bHost(static_cast<size_t>(B) * K * N);
        for (uint32_t b = 0; b < B; ++b)
            for (uint32_t m = 0; m < M; ++m)
                for (uint32_t k = 0; k < K; ++k)
                    aHost[static_cast<size_t>(b) * M * K + m * K + k] =
                        aclFloatToFloat16(static_cast<float>(m + 1));
        for (uint32_t b = 0; b < B; ++b)
            for (uint32_t k = 0; k < K; ++k)
                for (uint32_t n = 0; n < N; ++n)
                    bHost[static_cast<size_t>(b) * K * N + k * N + n] =
                        aclFloatToFloat16(static_cast<float>(n + 1));
        std::vector<float> biasHost(N, 0.0f);  // operator has no bias -> zero tensor

        CHECK_ACL(aclrtMemcpy(aDev, aFileSize, aHost.data(), aFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(bDev, bFileSize, bHost.data(), bFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(biasDev, biasFileSize, biasHost.data(), biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE));

        for (uint32_t b = 0; b < B; ++b) {
            const size_t aOff = static_cast<size_t>(b) * M * K;
            const size_t bOff = static_cast<size_t>(b) * K * N;
            v2_cube<<<1, 0, stream>>>(aDev + aOff * sizeof(aclFloat16), bDev + bOff * sizeof(aclFloat16), biasDev,
                                      cDev, wsDev, tiling);
            uint8_t* yElem = yDev + static_cast<size_t>(b) * sizeof(float);
            v2_reduce<<<1, 0, stream>>>(cDev, yElem, cs.M, cs.N);
        }
        CHECK_ACL(aclrtSynchronizeStream(stream));

        std::vector<float> yHost(B);
        CHECK_ACL(aclrtMemcpy(yHost.data(), yFileSize, yDev, yFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

        bool caseOk = true;
        for (uint32_t b = 0; b < B; ++b) {
            double yg = 0.0;
            for (uint32_t m = 0; m < M; ++m) {
                double rowMax = 0.0;
                for (uint32_t n = 0; n < N; ++n) {
                    const double v =
                        static_cast<double>(K) * (m + 1) * (n + 1);
                    if (n == 0 || v > rowMax) rowMax = v;
                }
                yg += rowMax;
            }
            const double got = static_cast<double>(yHost[b]);
            const double rel = std::fabs(got - yg) / (std::fabs(yg) + 1.0);
            if (rel > 1e-3) {
                caseOk = false;
                std::printf("    y[b=%u] got=%g exp=%g rel=%g DIFF\n", b, got, yg, rel);
            }
        }
        std::printf("[F7] %-28s -> %s  B=%u\n", cs.tag, caseOk ? "PASS" : "DIFF", cs.B);

        CHECK_ACL(aclrtFree(aDev));
        CHECK_ACL(aclrtFree(bDev));
        CHECK_ACL(aclrtFree(biasDev));
        CHECK_ACL(aclrtFree(cDev));
        CHECK_ACL(aclrtFree(yDev));
        if (wsDev != nullptr) CHECK_ACL(aclrtFree(wsDev));
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}

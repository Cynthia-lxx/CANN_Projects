#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                         __code);                                                                       \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)

// ============================================================================
// Probe F4 (shape_sweep) — Route-1 recipe validation: CType=GM + IterateAll(cGlobal),
// multi-core via the official CalcOffset pre-shift (03.05 blue paper formula). Host loops a
// shape grid (tail N, tiny N/M, K tail, multi-core), rebuilds tiling per shape and launches
// numBlocks == SetDim cores, then does a full relative-tolerance compare per shape.
//
// Data stays non-constant (A[m][k]=m+1, B[k][n]=n+1, bias=0.5) so tile placement errors show up
// (constant-golden checks are blind to misplacement — official 03.05's 511.5 test).
//
// Basis (read-only research, 2026-09-08):
//  - Official pairing: GenMatmulTiling(numBlocks) -> cubeTiling.SetDim(numBlocks) -> launch
//    <<<numBlocks>>>  (light 03.03 matmul_custom_tiling.h / matmul_custom.asc).
//  - usedCoreNum = (M/singleCoreM)*(N/singleCoreN); per-core manual Iterate count
//    mnIter_ = Ceil(singleCoreN,baseN)*Ceil(singleCoreM,baseM) (matmul_client.h L89-96/146-154).
//  - Recommended whole-C write: mm.IterateAll(cGlobal) (light 03.03 kernel cell).
// ============================================================================

AscendC::tiling::TCubeTiling GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform, int32_t M, int32_t N,
                                            int32_t K, int32_t numBlocks)
{
    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(numBlocks);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(128, 128, -1);
    cubeTiling.SetBias(true);
    cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr, "Generate matmul tiling failed (M=%d N=%d K=%d nb=%d).\n", M, N, K, numBlocks);
    }
    return cubeTilingData;
}

__aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

// Route-1 kernel: CType=GM, IterateAll writes the whole C slice directly; per-core GM origins
// shifted by the official CalcOffset formula (identical to matmul_abs.asc 03.05 kernel).
extern "C" __global__ __mix__(1, 2) void shape_sweep_mm(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    uint32_t mSingleBlocks = Ceiling(static_cast<uint32_t>(tiling.M), static_cast<uint32_t>(tiling.singleCoreM));
    uint32_t blockIdx = AscendC::GetBlockIdx();
    uint32_t mCoreIdx = blockIdx % mSingleBlocks;
    uint32_t nCoreIdx = blockIdx / mSingleBlocks;
    uint32_t offsetA = mCoreIdx * static_cast<uint32_t>(tiling.Ka) * static_cast<uint32_t>(tiling.singleCoreM);
    uint32_t offsetB = nCoreIdx * static_cast<uint32_t>(tiling.singleCoreN);
    uint32_t offsetC = mCoreIdx * static_cast<uint32_t>(tiling.N) * static_cast<uint32_t>(tiling.singleCoreM) +
                       nCoreIdx * static_cast<uint32_t>(tiling.singleCoreN);
    uint32_t offsetBias = nCoreIdx * static_cast<uint32_t>(tiling.singleCoreN);

    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> biasGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a) + offsetA,
                            static_cast<uint32_t>(tiling.M) * static_cast<uint32_t>(tiling.Ka) - offsetA);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b) + offsetB,
                            static_cast<uint32_t>(tiling.Kb) * static_cast<uint32_t>(tiling.N) - offsetB);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias) + offsetBias,
                               static_cast<uint32_t>(tiling.N) - offsetBias);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c) + offsetC,
                            static_cast<uint32_t>(tiling.M) * static_cast<uint32_t>(tiling.N) - offsetC);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(static_cast<uint32_t>(tiling.M), static_cast<uint32_t>(tiling.N),
                   static_cast<uint32_t>(tiling.Ka), static_cast<uint32_t>(tiling.Kb));
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);
    mm.SetBias(biasGlobal);
    mm.IterateAll(cGlobal);
    mm.End();
}

struct SweepCase {
    const char* tag;
    int32_t M;
    int32_t N;
    int32_t K;
    int32_t numBlocks;
};

int32_t main(int32_t argc, char** argv)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr) {
        std::fprintf(stderr, "ascendcPlatform null.\n");
        return 1;
    }
    const size_t workspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());

    // Shape grid under test. Route-1 recipe: SetDim == numBlocks. "tail"/"tiny" rows probe the
    // cube framework's real coverage boundary (internal padding vs shape gating needed).
    const SweepCase cases[] = {
        {"M256 N640 K256 nb1", 256, 640, 256, 1},
        {"M1024 N640 K256 nb2", 1024, 640, 256, 2},
        {"M256 N1000 K256 nb1(tailN)", 256, 1000, 256, 1},
        {"M256 N1000 K256 nb2(tailN)", 256, 1000, 256, 2},
        {"M1024 N1000 K256 nb2(tailN)", 1024, 1000, 256, 2},
        {"M128 N320 K256 nb1", 128, 320, 256, 1},
        {"M1024 N320 K256 nb2", 1024, 320, 256, 2},
        {"M64 N640 K256 nb1(M<baseM)", 64, 640, 256, 1},
        {"M256 N16 K256 nb1(tinyN)", 256, 16, 256, 1},
        {"M256 N640 K200 nb1(Ktail)", 256, 640, 200, 1},
        {"M2048 N320 K256 nb4", 2048, 320, 256, 4},
        {"M1024 N1000 K256 nb4(tailN)", 1024, 1000, 256, 4},
    };
    constexpr uint32_t numCases = sizeof(cases) / sizeof(cases[0]);

    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    std::printf("shape_sweep: route1 (SetDim==numBlocks, IterateAll GM-C), tol=1e-3. F4 run.\n");
    for (uint32_t ci = 0; ci < numCases; ++ci) {
        const SweepCase& cs = cases[ci];
        const uint32_t M = static_cast<uint32_t>(cs.M);
        const uint32_t N = static_cast<uint32_t>(cs.N);
        const uint32_t K = static_cast<uint32_t>(cs.K);
        const uint32_t numBlocks = static_cast<uint32_t>(cs.numBlocks);

        auto tiling = GenerateTiling(ascendcPlatform, cs.M, cs.N, cs.K, cs.numBlocks);
        if (tiling.M != cs.M || tiling.N != cs.N) {  // GetTiling returned -1 (fields left unset)
            std::printf("[F4] %-28s -> TILING_FAIL (skipped)\n", cs.tag);
            continue;
        }
        const size_t aFileSize = static_cast<size_t>(M) * K * sizeof(aclFloat16);
        const size_t bFileSize = static_cast<size_t>(K) * N * sizeof(aclFloat16);
        const size_t biasFileSize = static_cast<size_t>(N) * sizeof(float);
        const size_t cFileSize = static_cast<size_t>(M) * N * sizeof(float);

        uint8_t* aDev = nullptr;
        uint8_t* bDev = nullptr;
        uint8_t* biasDev = nullptr;
        uint8_t* cDev = nullptr;
        uint8_t* wsDev = nullptr;
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&aDev), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&bDev), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&biasDev), biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&cDev), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
        if (workspaceSize > 0) {
            CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&wsDev), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST));
        }

        // A[m][k]=m+1, B[k][n]=n+1, bias=0.5 -> golden = K*(m+1)*(n+1) + 0.5. All values positive.
        std::vector<aclFloat16> aHost(M * K);
        std::vector<aclFloat16> bHost(K * N);
        for (uint32_t m = 0; m < M; ++m)
            for (uint32_t k = 0; k < K; ++k) aHost[m * K + k] = aclFloatToFloat16(static_cast<float>(m + 1));
        for (uint32_t k = 0; k < K; ++k)
            for (uint32_t n = 0; n < N; ++n) bHost[k * N + n] = aclFloatToFloat16(static_cast<float>(n + 1));
        std::vector<float> biasHost(N, 0.5f);
        std::vector<float> cHost(M * N, 0.0f);
        std::vector<float> golden(M * N);
        for (uint32_t m = 0; m < M; ++m)
            for (uint32_t n = 0; n < N; ++n)
                golden[m * N + n] = static_cast<float>(K) * static_cast<float>(m + 1) * static_cast<float>(n + 1) + 0.5f;

        CHECK_ACL(aclrtMemcpy(aDev, aFileSize, aHost.data(), aFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(bDev, bFileSize, bHost.data(), bFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(biasDev, biasFileSize, biasHost.data(), biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemsetAsync(cDev, cFileSize, 0, cFileSize, stream));

        shape_sweep_mm<<<numBlocks, 0, stream>>>(aDev, bDev, biasDev, cDev, wsDev, tiling);
        CHECK_ACL(aclrtSynchronizeStream(stream));
        CHECK_ACL(aclrtMemcpy(cHost.data(), cFileSize, cDev, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

        // Full relative-tolerance compare.
        const double relTol = 1e-3;
        double maxRel = 0.0;
        size_t bad = 0;
        size_t firstBad = 0;
        for (size_t i = 0; i < static_cast<size_t>(M) * N; ++i) {
            const double got = static_cast<double>(cHost[i]);
            const double exp = static_cast<double>(golden[i]);
            const double rel = std::fabs(got - exp) / (std::fabs(exp) + 1.0);
            if (rel > maxRel) maxRel = rel;
            if (rel > relTol) {
                if (bad == 0) firstBad = i;
                ++bad;
            }
        }
        const bool ok = (bad == 0);
        std::printf("[F4] %-28s -> %s  bad=%zu/%zu maxRel=%g  scM=%u scN=%u", cs.tag,
                    ok ? "PASS" : "DIFF", bad, static_cast<size_t>(M) * N, maxRel,
                    static_cast<uint32_t>(tiling.singleCoreM), static_cast<uint32_t>(tiling.singleCoreN));
        if (!ok) {
            const uint32_t fm = static_cast<uint32_t>(firstBad / N);
            const uint32_t fn = static_cast<uint32_t>(firstBad % N);
            std::printf("  first@(m=%u,n=%u) got=%g exp=%g", fm, fn,
                        static_cast<double>(cHost[firstBad]), static_cast<double>(golden[firstBad]));
        }
        std::printf("\n");

        CHECK_ACL(aclrtFree(aDev));
        CHECK_ACL(aclrtFree(bDev));
        CHECK_ACL(aclrtFree(biasDev));
        CHECK_ACL(aclrtFree(cDev));
        if (wsDev != nullptr) CHECK_ACL(aclrtFree(wsDev));
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}

// P1 v3 probe: minimal adv_api Matmul compile/link/run check on 910B (dav-2201).
//
// Blueprint: tutorials/ascendc_operator_development_light/03_simple_operator_practice/answer/03.05/matmul_abs.asc
//   - single .asc = host + kernel in one TU, host uses matmul_tiling::MultiCoreMatmulTiling
//   - kernel: REGIST_MATMUL_OBJ + Iterate<true> + GetTensorC<true>(local,false,true) + DataCopy per-tile out
//
// Probe shape: M=N=K=64, fp16(A,B) -> fp32(C), 1 core (dim=1), baseM=baseN=32 -> 4 tiles, FIRSTM order.
// A[m][k] = m+1 (fp16 exact), B[k][n] = n+1 (fp16 exact)  =>  C[m][n] = K*(m+1)*(n+1), exact in fp32.
// Host compares full C element-by-element.  Any tile-order / offset / GetTensorC bug shows up as a mismatch.
//
// Probe E (dual-mode gate): two kernel entries with IDENTICAL signatures (a,b,c,workspace,tiling) so no
// scalar-kernel-param compile risk. Both iterate ONLY the first tile (tile0) and write the raw GetTensorC
// UB tile to a continuous side band + the normal strided main region.
//   cube_probe       (mode 0): GetTensorC -> EnQue -> DataCopy              (raw; worked: 32/32 G)
//   cube_probe_abs   (mode 1): GetTensorC -> in-place Abs -> EnQue -> DataCopy
//   cube_probe_qabs  (mode 2): GetTensorC -> EnQue -> DeQue/Free -> Alloc -> in-place Abs -> EnQue -> DataCopy
//                              (Abs moved AFTER the first queue handshake, as an independent second producer)
//   cube_probe_max   (mode 3): GetTensorC -> in-place Max(x,x) -> EnQue -> DataCopy
//                              (different vector instruction than Abs, same pre-EnQue position)
// Observed on cloud (Probe E): mode0 rows all G (full product); mode1 rows r>=1 = P = (K-1)/K*golden[r-2]
// fingerprint -> one k-term (of K=64) lost AND row shift by 2. Abs is a value no-op here (all data
// positive), so mode1 only differs from mode0 by the vector-pipe "consume before EnQue". Questions:
//   Q1 (mode2): does moving the vector op AFTER the queue handshake restore G?  -> yes = the op must not
//      run inside GetTensorC's own event window; no = something deeper (Abs on this buffer path).
//   Q2 (mode3): is it Abs-specific or any pre-EnQue vector consumer?  -> mode3 P == generic vector issue.
//   Q3 (mode0 main row32=S anomaly) is re-checked in the row dumps.
//
// This is an isolated probe dir; it does NOT touch the v1 batch_matmul_max_sum_custom build.

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                         __code);                                                                       \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)

AscendC::tiling::TCubeTiling GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform)
{
    constexpr int32_t M = 64;
    constexpr int32_t N = 64;
    constexpr int32_t K = 64;
    constexpr int32_t baseM = 32;
    constexpr int32_t baseN = 32;

    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(1);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(baseM, baseN, -1);
    cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr, "Generate matmul tiling failed.\n");
    }
    return cubeTilingData;
}

__aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

template <typename AType, typename BType, typename CType>
class CubeProbeKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
                                const AscendC::tiling::TCubeTiling& tiling, AscendC::TPipe* pipe);
    __aicore__ inline void Process();
    __aicore__ inline void MatmulCompute();
    __aicore__ inline void CopyOut(uint32_t count);
    __aicore__ inline void CalcOffset(int32_t blockIdx, const AscendC::tiling::TCubeTiling& tiling,
                                      int32_t& offsetA, int32_t& offsetB, int32_t& offsetC);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, AType>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BType>,
           MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, CType>>
        matmulObj;

    AscendC::GlobalTensor<AType> aGlobal;
    AscendC::GlobalTensor<BType> bGlobal;
    AscendC::GlobalTensor<CType> cGlobal;
    AscendC::LocalTensor<CType> cTileLocal;
    AscendC::tiling::TCubeTiling tiling;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> cTileQueue;
    // Probe E/F3: mode = 0 raw | 1 pre-EnQue Abs | 2 post-queue Abs | 3 pre-EnQue Max(x,x).
    uint32_t mode = 0;
};

template <typename AType, typename BType, typename CType>
__aicore__ inline void CubeProbeKernel<AType, BType, CType>::Init(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    const AscendC::tiling::TCubeTiling& tiling, AscendC::TPipe* pipe)
{
    this->tiling = tiling;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AType*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BType*>(b), tiling.Kb * tiling.N);
    // GM buffer sized M*N + 2 mirror side bands (2 * baseM*baseN floats) for Probe E.
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ CType*>(c),
                            tiling.M * tiling.N + 2 * tiling.baseM * tiling.baseN);

    int32_t offsetA = 0;
    int32_t offsetB = 0;
    int32_t offsetC = 0;
    CalcOffset(AscendC::GetBlockIdx(), tiling, offsetA, offsetB, offsetC);
    aGlobal = aGlobal[offsetA];
    bGlobal = bGlobal[offsetB];
    cGlobal = cGlobal[offsetC];
    pipe->InitBuffer(cTileQueue, 1, tiling.baseM * tiling.baseN * sizeof(CType));
}

template <typename AType, typename BType, typename CType>
__aicore__ inline void CubeProbeKernel<AType, BType, CType>::Process()
{
    uint32_t computeRound = 0;
    matmulObj.SetTensorA(aGlobal);
    matmulObj.SetTensorB(bGlobal);
    // Probe B/E (gated writeback): compute only the FIRST iterated tile. CopyOut additionally
    // mirrors the raw/abs GetTensorC UB tile to a GM side band (continuous stride-free copy)
    // alongside the main strided writeback, so host can bisect "GetTensorC product wrong"
    // vs "strided DataCopy wrong" and compare consumption paths (mode0 raw vs mode1 Abs barrier).
    if (matmulObj.template Iterate<true>()) {
        MatmulCompute();
        CopyOut(computeRound);
        ++computeRound;
    }
    matmulObj.End();
}

template <typename AType, typename BType, typename CType>
__aicore__ inline void CubeProbeKernel<AType, BType, CType>::MatmulCompute()
{
    cTileLocal = cTileQueue.AllocTensor<CType>();
    matmulObj.template GetTensorC<true>(cTileLocal, false, true);
    if (mode == 1) {
        // Official vector-consumer order (matmul_abs.asc AbsCompute): in-place Abs right after
        // GetTensorC and BEFORE EnQue. Value no-op here (all data positive), pure barrier probe.
        AscendC::Abs(cTileLocal, cTileLocal, tiling.baseM * tiling.baseN);
    } else if (mode == 3) {
        // Same pre-EnQue position but a different vector instruction (Max(x,x)=x): discriminates
        // "Abs-specific" from "any pre-EnQue vector consumer".
        AscendC::Max(cTileLocal, cTileLocal, cTileLocal, tiling.baseM * tiling.baseN);
    }
    cTileQueue.EnQue(cTileLocal);
}

template <typename AType, typename BType, typename CType>
__aicore__ inline void CubeProbeKernel<AType, BType, CType>::CopyOut(uint32_t count)
{
    cTileQueue.DeQue<CType>();
    if (mode == 2) {
        // Abs as an INDEPENDENT second producer, after the first queue handshake has returned the
        // tile. Free/Alloc on a depth-1 queue reuses the same buffer (content still resident),
        // so Abs reads exactly what the raw GetTensorC delivered.
        cTileQueue.FreeTensor(cTileLocal);
        cTileLocal = cTileQueue.AllocTensor<CType>();
        AscendC::Abs(cTileLocal, cTileLocal, tiling.baseM * tiling.baseN);
        cTileQueue.EnQue(cTileLocal);
        cTileQueue.DeQue<CType>();
    }
    // Probe B/E mirror: continuous stride-free copy of the same UB tile -> GM side band.
    // Each mode owns band `mode` at [M*N + mode*baseM*baseN, +baseM*baseN).
    AscendC::DataCopyParams mirrorParam = {
        static_cast<uint16_t>(tiling.baseM),
        static_cast<uint16_t>(tiling.baseN * sizeof(CType) / AscendC::DEFAULT_C0_SIZE),
        0,
        0};
    AscendC::DataCopy(cGlobal[tiling.M * tiling.N + mode * tiling.baseM * tiling.baseN], cTileLocal, mirrorParam);

    const uint32_t roundM = tiling.singleCoreM / tiling.baseM;
    uint32_t startOffset = count % roundM * tiling.baseM * tiling.N + count / roundM * tiling.baseN;
    AscendC::DataCopyParams copyParam = {
        static_cast<uint16_t>(tiling.baseM),
        static_cast<uint16_t>(tiling.baseN * sizeof(CType) / AscendC::DEFAULT_C0_SIZE),
        0,
        static_cast<uint16_t>((tiling.N - tiling.baseN) * sizeof(CType) / AscendC::DEFAULT_C0_SIZE)};
    AscendC::DataCopy(cGlobal[startOffset], cTileLocal, copyParam);
    cTileQueue.FreeTensor(cTileLocal);
}

template <typename AType, typename BType, typename CType>
__aicore__ inline void CubeProbeKernel<AType, BType, CType>::CalcOffset(
    int32_t blockIdx, const AscendC::tiling::TCubeTiling& tiling, int32_t& offsetA, int32_t& offsetB,
    int32_t& offsetC)
{
    uint32_t mSingleBlocks = Ceiling(tiling.M, tiling.singleCoreM);
    uint32_t mCoreIdx = blockIdx % mSingleBlocks;
    uint32_t nCoreIdx = blockIdx / mSingleBlocks;
    offsetA = mCoreIdx * tiling.Ka * tiling.singleCoreM;
    offsetB = nCoreIdx * tiling.singleCoreN;
    offsetC = mCoreIdx * tiling.N * tiling.singleCoreM + nCoreIdx * tiling.singleCoreN;
}

// mode0: raw GetTensorC -> EnQue -> DataCopy  (unchanged original behavior)
extern "C" __global__ __mix__(1, 2) void cube_probe(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    CubeProbeKernel<half, half, float> op;
    op.Init(a, b, c, tiling, &pipe);
    op.mode = 0;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &op.tiling);
    op.Process();
}

// mode1: GetTensorC -> in-place Abs barrier -> EnQue -> DataCopy (official vector-consumer order)
extern "C" __global__ __mix__(1, 2) void cube_probe_abs(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    CubeProbeKernel<half, half, float> op;
    op.Init(a, b, c, tiling, &pipe);
    op.mode = 1;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &op.tiling);
    op.Process();
}

// mode2: GetTensorC -> EnQue -> DeQue/Free -> Alloc -> Abs -> EnQue -> DataCopy
//        (Abs as independent second producer AFTER the queue handshake)
extern "C" __global__ __mix__(1, 2) void cube_probe_qabs(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    CubeProbeKernel<half, half, float> op;
    op.Init(a, b, c, tiling, &pipe);
    op.mode = 2;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &op.tiling);
    op.Process();
}

// mode3: GetTensorC -> in-place Max(x,x) -> EnQue -> DataCopy (non-Abs pre-EnQue consumer)
extern "C" __global__ __mix__(1, 2) void cube_probe_max(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    CubeProbeKernel<half, half, float> op;
    op.Init(a, b, c, tiling, &pipe);
    op.mode = 3;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &op.tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host-side classification helpers.  All expected values are exact small
// integers:  C[m][n] = K*(m+1)*(n+1).
//   G model : row holds golden[r]          = K*(r+1)*(n+1)
//   P model : row holds (K-1)/K*golden[r-2] = (K-1)*(r-1)*(n+1)  (one k-term lost, r >= 2)
//   S model : row holds (K-1)/K*golden[m-1] = (K-1)*m*(n+1)      (main-region shift, m >= 1)
// ---------------------------------------------------------------------------
static char MirrorFitChar(const std::vector<float>& h, uint32_t base, uint32_t row, uint32_t K, uint32_t tileN)
{
    uint32_t zero = 0;
    uint32_t g = 0;
    uint32_t p = 0;
    for (uint32_t n = 0; n < tileN; ++n) {
        const float v = h[base + row * tileN + n];
        if (v == 0.0f) {
            ++zero;
        } else if (v == static_cast<float>(K * (row + 1) * (n + 1))) {
            ++g;
        } else if ((row >= 2) && (v == static_cast<float>((K - 1) * (row - 1) * (n + 1)))) {
            ++p;
        }
    }
    if (zero == tileN) {
        return '0';
    }
    if (g == tileN) {
        return 'G';
    }
    if (p == tileN) {
        return 'P';
    }
    return 'x';
}

static char MainFitChar(const std::vector<float>& h, uint32_t row, uint32_t N, uint32_t K, uint32_t tileN)
{
    uint32_t zero = 0;
    uint32_t g = 0;
    uint32_t s = 0;
    for (uint32_t n = 0; n < tileN; ++n) {
        const float v = h[row * N + n];
        if (v == 0.0f) {
            ++zero;
        } else if (v == static_cast<float>(K * (row + 1) * (n + 1))) {
            ++g;
        } else if ((row >= 1) && (v == static_cast<float>((K - 1) * row * (n + 1)))) {
            ++s;
        }
    }
    if (zero == tileN) {
        return '0';
    }
    if (g == tileN) {
        return 'G';
    }
    if (s == tileN) {
        return 'S';
    }
    return 'x';
}

int32_t main(int32_t argc, char** argv)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();

    constexpr uint32_t M = 64;
    constexpr uint32_t N = 64;
    constexpr uint32_t K = 64;
    constexpr uint32_t numBlocks = 1;
    constexpr uint32_t tileM = 32;
    constexpr uint32_t tileN = 32;
    constexpr uint32_t tileFloats = tileM * tileN; // 1024
    constexpr uint32_t mirrorBands = 4;            // mode0..3: raw | pre-EnQue Abs | post-queue Abs | pre-EnQue Max
    const size_t aFileSize = M * K * sizeof(aclFloat16);
    const size_t bFileSize = K * N * sizeof(aclFloat16);
    // C GM gets 2*1024 extra floats at M*N for the Probe E side bands.
    const size_t cFileSize = (M * N + mirrorBands * tileFloats) * sizeof(float);
    const size_t workspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
    auto tiling = GenerateTiling(ascendcPlatform);

    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    uint8_t* inputADevice = nullptr;
    uint8_t* inputBDevice = nullptr;
    uint8_t* outputCDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&inputADevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&inputBDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&outputCDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    if (workspaceSize > 0) {
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&workspaceDevice), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST));
    }

    // A[m][k] = m+1, B[k][n] = n+1  ->  C[m][n] = K*(m+1)*(n+1), exact in fp16/fp32.
    std::vector<aclFloat16> inputAHost(M * K);
    std::vector<aclFloat16> inputBHost(K * N);
    for (uint32_t m = 0; m < M; ++m) {
        for (uint32_t k = 0; k < K; ++k) {
            inputAHost[m * K + k] = aclFloatToFloat16(static_cast<float>(m + 1));
        }
    }
    for (uint32_t k = 0; k < K; ++k) {
        for (uint32_t n = 0; n < N; ++n) {
            inputBHost[k * N + n] = aclFloatToFloat16(static_cast<float>(n + 1));
        }
    }
    std::vector<float> golden(M * N);
    for (uint32_t m = 0; m < M; ++m) {
        for (uint32_t n = 0; n < N; ++n) {
            golden[m * N + n] = static_cast<float>(K) * static_cast<float>(m + 1) * static_cast<float>(n + 1);
        }
    }
    std::vector<float> outMode0(cFileSize / sizeof(float), 0.0f);
    std::vector<float> outMode1(cFileSize / sizeof(float), 0.0f);
    std::vector<float> outMode2(cFileSize / sizeof(float), 0.0f);
    std::vector<float> outMode3(cFileSize / sizeof(float), 0.0f);

    CHECK_ACL(aclrtMemcpy(inputADevice, aFileSize, inputAHost.data(), aFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(inputBDevice, bFileSize, inputBHost.data(), bFileSize, ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- mode0: raw GetTensorC -> EnQue -> DataCopy ----
    CHECK_ACL(aclrtMemsetAsync(outputCDevice, cFileSize, 0, cFileSize, stream));
    cube_probe<<<numBlocks, 0, stream>>>(inputADevice, inputBDevice, outputCDevice, workspaceDevice, tiling);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outMode0.data(), cFileSize, outputCDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

    // ---- mode1: GetTensorC -> in-place Abs barrier -> EnQue -> DataCopy ----
    CHECK_ACL(aclrtMemsetAsync(outputCDevice, cFileSize, 0, cFileSize, stream));
    cube_probe_abs<<<numBlocks, 0, stream>>>(inputADevice, inputBDevice, outputCDevice, workspaceDevice, tiling);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outMode1.data(), cFileSize, outputCDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

    // ---- mode2: GetTensorC -> EnQue -> DeQue/Free -> Alloc -> Abs -> EnQue -> DataCopy ----
    CHECK_ACL(aclrtMemsetAsync(outputCDevice, cFileSize, 0, cFileSize, stream));
    cube_probe_qabs<<<numBlocks, 0, stream>>>(inputADevice, inputBDevice, outputCDevice, workspaceDevice, tiling);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outMode2.data(), cFileSize, outputCDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

    // ---- mode3: GetTensorC -> in-place Max(x,x) -> EnQue -> DataCopy ----
    CHECK_ACL(aclrtMemsetAsync(outputCDevice, cFileSize, 0, cFileSize, stream));
    cube_probe_max<<<numBlocks, 0, stream>>>(inputADevice, inputBDevice, outputCDevice, workspaceDevice, tiling);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outMode3.data(), cFileSize, outputCDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

    std::printf("tiling M=%d N=%d Ka=%d Kb=%d baseM=%d baseN=%d singleCoreM=%d singleCoreN=%d\n",
                static_cast<int>(tiling.M), static_cast<int>(tiling.N), static_cast<int>(tiling.Ka),
                static_cast<int>(tiling.Kb), static_cast<int>(tiling.baseM), static_cast<int>(tiling.baseN),
                static_cast<int>(tiling.singleCoreM), static_cast<int>(tiling.singleCoreN));
    std::printf("mode legend: G=row==golden[r]  P=row==(K-1)/K*golden[r-2] (lost-k partial sum)  "
                "S=row==(K-1)/K*golden[m-1]  0=zero row  x=other\n");

    auto dumpMode = [&](const char* tag, const std::vector<float>& h, uint32_t mode) {
        // Full main-region compare.
        double maxDiff = 0.0;
        size_t mismatches = 0;
        for (uint32_t m = 0; m < M; ++m) {
            for (uint32_t n = 0; n < N; ++n) {
                const double d = std::fabs(static_cast<double>(h[m * N + n] - golden[m * N + n]));
                maxDiff = std::max(maxDiff, d);
                if (h[m * N + n] != golden[m * N + n]) {
                    ++mismatches;
                }
            }
        }
        std::printf("%s full C compare: mismatches=%zu/%u maxDiff=%g\n", tag, mismatches,
                    static_cast<uint32_t>(M * N), maxDiff);

        // Mirror band = raw/abs GetTensorC tile0 (rows 0..31), continuous side-band copy.
        const uint32_t mirrorBase = M * N + mode * tileFloats;
        char fit[33];
        uint32_t cntG = 0;
        uint32_t cntP = 0;
        uint32_t cntZero = 0;
        uint32_t cntX = 0;
        size_t mirrorGood = 0;
        for (uint32_t r = 0; r < tileM; ++r) {
            char c = MirrorFitChar(h, mirrorBase, r, K, tileN);
            fit[r] = c;
            switch (c) {
                case 'G':
                    ++cntG;
                    mirrorGood += tileN;
                    break;
                case 'P':
                    ++cntP;
                    break;
                case '0':
                    ++cntZero;
                    break;
                default:
                    ++cntX;
                    break;
            }
        }
        fit[tileM] = '\0';
        std::printf("%s mirror band row0..31: %s\n", tag, fit);
        std::printf("%s mirror counts: G=%u P=%u 0=%u x=%u (G elems=%u/1024)\n", tag, cntG, cntP, cntZero, cntX,
                    static_cast<uint32_t>(mirrorGood));
        const uint32_t showRows[] = {0, 1, 2, 31};
        for (uint32_t si = 0; si < sizeof(showRows) / sizeof(showRows[0]); ++si) {
            const uint32_t r = showRows[si];
            std::printf("%s mirror row%2u n0-3:", tag, r);
            for (uint32_t n = 0; n < 4; ++n) {
                std::printf(" %.0f", h[mirrorBase + r * tileN + n]);
            }
            std::printf("\n");
        }

        // Main strided region (rows 0..63, cols 0..31 written by DataCopy dstGap=4).
        char mfit[65];
        for (uint32_t r = 0; r < 64; ++r) {
            mfit[r] = MainFitChar(h, r, N, K, tileN);
        }
        mfit[64] = '\0';
        std::printf("%s main strided rows0..63: %s\n", tag, mfit);
        std::printf("%s main counts: G=%u S=%u 0=%u x=%u\n", tag,
                    static_cast<uint32_t>(std::count(mfit, mfit + 64, 'G')),
                    static_cast<uint32_t>(std::count(mfit, mfit + 64, 'S')),
                    static_cast<uint32_t>(std::count(mfit, mfit + 64, '0')),
                    static_cast<uint32_t>(std::count(mfit, mfit + 64, 'x')));
    };

    dumpMode("mode0", outMode0, 0);
    dumpMode("mode1", outMode1, 1);
    dumpMode("mode2", outMode2, 2);
    dumpMode("mode3", outMode3, 3);

    CHECK_ACL(aclrtFree(inputADevice));
    CHECK_ACL(aclrtFree(inputBDevice));
    CHECK_ACL(aclrtFree(outputCDevice));
    if (workspaceDevice != nullptr) {
        CHECK_ACL(aclrtFree(workspaceDevice));
    }
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}

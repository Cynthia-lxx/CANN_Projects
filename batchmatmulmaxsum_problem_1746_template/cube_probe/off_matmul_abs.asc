// Probe B official baseline: verbatim copy of the official tutorial answer
//   tutorials/ascendc_operator_development_light/03_simple_operator_practice/answer/03.05/matmul_abs.asc
// (CANN_Learning_Hub_(for_dev)). Intentional NO local adaptation: used only to check whether
// this exact matmul paradigm (REGIST_MATMUL_OBJ + Iterate<true> + GetTensorC<true>(t,false,true)
// + strided DataCopy) passes as-is on dav-2201 / CANN 9.0.0. Do not edit its logic; keep diffable
// against the official file.
// Probe D (NC) note: host main() ONLY was adapted to non-constant inputs (A=m+1, B=n+1) plus
// relative-tolerance compare / coverage & identity prints, to defeat the constant 511.5 blind
// golden. Kernel class and every kernel call site remain byte-identical to the official file.
// Probe F (NC-F): host further parameterized to sweep (SetDim,numBlocks) in {(1,1),(2,2),(2,1)}
// for the multi-tile / grid-vs-dim forensics; GenerateTiling got a `dim` param, kernel untouched.
// F1(1,1): single core whole M*N; F2(2,2): dim==grid; base(2,1): the previously-run config.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                         __code);                                                                       \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)

AscendC::tiling::TCubeTiling GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform, int32_t dim)
{
    constexpr int32_t M = 1024;
    constexpr int32_t N = 640;
    constexpr int32_t K = 256;
    constexpr int32_t baseM = 128;
    constexpr int32_t baseN = 128;

    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(dim);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(baseM, baseN, -1);
    cubeTiling.SetBias(true);
    cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr, "Generate matmul tiling failed.\n");
    }
    return cubeTilingData;
}

__aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}


template <typename AType, typename BType, typename CType, typename BiasType>
class MatmulAbsKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c,
                                const TCubeTiling& tiling, AscendC::TPipe* pipe);
    __aicore__ inline void Process();
    __aicore__ inline void MatmulCompute();
    __aicore__ inline void AbsCompute();
    __aicore__ inline void CopyOut(uint32_t count);
    __aicore__ inline void CalcOffset(int32_t blockIdx, const TCubeTiling& tiling, int32_t& offsetA,
                                      int32_t& offsetB, int32_t& offsetC, int32_t& offsetBias);

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, AType>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BType>,
           MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, CType>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BiasType>>
        matmulObj;

    AscendC::GlobalTensor<AType> aGlobal;
    AscendC::GlobalTensor<BType> bGlobal;
    AscendC::GlobalTensor<CType> cGlobal;
    AscendC::GlobalTensor<BiasType> biasGlobal;
    AscendC::LocalTensor<CType> absOutLocal;
    TCubeTiling tiling;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> absOutQueue;
};

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::Init(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c, const TCubeTiling& tiling,
    AscendC::TPipe* pipe)
{
    this->tiling = tiling;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AType*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BType*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ CType*>(c), tiling.M * tiling.N);
    biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BiasType*>(bias), tiling.N);

    int32_t offsetA = 0;
    int32_t offsetB = 0;
    int32_t offsetC = 0;
    int32_t offsetBias = 0;
    CalcOffset(AscendC::GetBlockIdx(), tiling, offsetA, offsetB, offsetC, offsetBias);
    aGlobal = aGlobal[offsetA];
    bGlobal = bGlobal[offsetB];
    cGlobal = cGlobal[offsetC];
    biasGlobal = biasGlobal[offsetBias];
    pipe->InitBuffer(absOutQueue, 1, tiling.baseM * tiling.baseN * sizeof(CType));
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::Process()
{
    uint32_t computeRound = 0;
    matmulObj.SetTensorA(aGlobal);
    matmulObj.SetTensorB(bGlobal);
    matmulObj.SetBias(biasGlobal);
    while (matmulObj.template Iterate<true>()) {
        MatmulCompute();
        AbsCompute();
        CopyOut(computeRound);
        ++computeRound;
    }
    matmulObj.End();
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::MatmulCompute()
{
    absOutLocal = absOutQueue.AllocTensor<CType>();
    matmulObj.template GetTensorC<true>(absOutLocal, false, true);
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::AbsCompute()
{
    AscendC::Abs(absOutLocal, absOutLocal, tiling.baseM * tiling.baseN);
    absOutQueue.EnQue(absOutLocal);
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::CopyOut(uint32_t count)
{
    absOutQueue.DeQue<CType>();
    const uint32_t roundM = tiling.singleCoreM / tiling.baseM;
    uint32_t startOffset = count % roundM * tiling.baseM * tiling.N + count / roundM * tiling.baseN;
    AscendC::DataCopyParams copyParam = {
        static_cast<uint16_t>(tiling.baseM),
        static_cast<uint16_t>(tiling.baseN * sizeof(CType) / AscendC::DEFAULT_C0_SIZE),
        0,
        static_cast<uint16_t>((tiling.N - tiling.baseN) * sizeof(CType) / AscendC::DEFAULT_C0_SIZE)};
    AscendC::DataCopy(cGlobal[startOffset], absOutLocal, copyParam);
    absOutQueue.FreeTensor(absOutLocal);
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulAbsKernel<AType, BType, CType, BiasType>::CalcOffset(
    int32_t blockIdx, const TCubeTiling& tiling, int32_t& offsetA, int32_t& offsetB, int32_t& offsetC,
    int32_t& offsetBias)
{
    uint32_t mSingleBlocks = Ceiling(tiling.M, tiling.singleCoreM);
    uint32_t mCoreIdx = blockIdx % mSingleBlocks;
    uint32_t nCoreIdx = blockIdx / mSingleBlocks;
    offsetA = mCoreIdx * tiling.Ka * tiling.singleCoreM;
    offsetB = nCoreIdx * tiling.singleCoreN;
    offsetC = mCoreIdx * tiling.N * tiling.singleCoreM + nCoreIdx * tiling.singleCoreN;
    offsetBias = nCoreIdx * tiling.singleCoreN;
}

// Host-side forensic report (single mode). Prints are machine-readable so results can be
// pasted back and diffed directly against the previous baseline output.
static void PrintFullReport(const char* tag, const AscendC::tiling::TCubeTiling& tiling,
                            const std::vector<float>& outputCHost, const std::vector<float>& golden, uint32_t M,
                            uint32_t N, uint32_t K, uint32_t dim, uint32_t numBlocks)
{
    const double relTol = 1e-3;
    std::printf("==================== %s (SetDim=%u, launch numBlocks=%u) ====================\n", tag, dim,
                numBlocks);
    std::printf("result is:\n");
    for (uint32_t i = 0; i < 10; ++i) {
        std::printf("%.1f ", outputCHost[i]);
    }
    std::printf("\n");
    std::printf("tiling M=%d N=%d K=%d baseM=%d baseN=%d singleCoreM=%d singleCoreN=%d\n",
                static_cast<int>(tiling.M), static_cast<int>(tiling.N), static_cast<int>(tiling.Ka),
                static_cast<int>(tiling.baseM), static_cast<int>(tiling.baseN),
                static_cast<int>(tiling.singleCoreM), static_cast<int>(tiling.singleCoreN));

    // Relative-tolerance full compare: fp32 K-accumulation rounding is ~1e-5 relative,
    // while an adjacent golden row m differs by 1/(m+1) >= ~1e-3, so tol 1e-3 still
    // separates row/col misplacement from rounding.
    double maxRel = 0.0;
    size_t bad = 0;
    for (size_t i = 0; i < static_cast<size_t>(M) * N; ++i) {
        const double got = static_cast<double>(outputCHost[i]);
        const double exp = static_cast<double>(golden[i]);
        const double rel = std::fabs(got - exp) / (std::fabs(exp) + 1.0);
        if (rel > maxRel) {
            maxRel = rel;
        }
        if (rel > relTol) {
            ++bad;
        }
    }
    std::printf("full compare: bad=%zu/%u maxRel=%g (tol %.0e)\n", bad, static_cast<uint32_t>(M) * N, maxRel,
                relTol);

    // Per-core-slab coverage grid (what the tiling claims each core owns) vs actually-good.
    const uint32_t scM = static_cast<uint32_t>(tiling.singleCoreM);
    const uint32_t scN = static_cast<uint32_t>(tiling.singleCoreN);
    const uint32_t gridR = (M + scM - 1) / scM;
    const uint32_t gridC = (N + scN - 1) / scN;
    std::printf("per-core-slab coverage (good/total; scM=%u scN=%u grid=%ux%u):\n", scM, scN, gridR, gridC);
    for (uint32_t r = 0; r < gridR; ++r) {
        for (uint32_t c = 0; c < gridC; ++c) {
            uint32_t goodCnt = 0;
            uint32_t totCnt = 0;
            const uint32_t mHi = ((r + 1) * scM < M) ? (r + 1) * scM : M;
            const uint32_t nHi = ((c + 1) * scN < N) ? (c + 1) * scN : N;
            for (uint32_t m = r * scM; m < mHi; ++m) {
                for (uint32_t n = c * scN; n < nHi; ++n) {
                    ++totCnt;
                    const double got = static_cast<double>(outputCHost[m * N + n]);
                    const double exp = static_cast<double>(golden[m * N + n]);
                    if (std::fabs(got - exp) / (std::fabs(exp) + 1.0) <= relTol) {
                        ++goodCnt;
                    }
                }
            }
            std::printf("  [r%u c%u]=%u/%u", r, c, goodCnt, totCnt);
        }
        std::printf("\n");
    }

    // Row identity via column 0: C[m][0] = K*(m+1) + 0.5, strictly monotonic in m.
    const uint32_t sampleMs[] = {0, 1, 2, 15, 31, 32, 33, 63, 64, 127, 255, 511, 512, 513, 1023};
    std::printf("row identity C[m][0] (got vs %u*(m+1)+0.5):\n", K);
    for (uint32_t si = 0; si < sizeof(sampleMs) / sizeof(sampleMs[0]); ++si) {
        const uint32_t m = sampleMs[si];
        if (m >= M) {
            continue;
        }
        const float got = outputCHost[m * N];
        const double exp = static_cast<double>(K) * static_cast<double>(m + 1) + 0.5;
        const double rel = std::fabs(static_cast<double>(got) - exp) / (exp + 1.0);
        std::printf("  m=%4u got=%12.1f exp=%12.1f %s\n", m, static_cast<double>(got), exp,
                    (rel <= relTol) ? "OK" : "DIFF");
    }

    // Column identity along row 0: C[0][n] = K*(n+1) + 0.5, strictly monotonic in n.
    const uint32_t sampleNs[] = {0, 1, 31, 32, 127, 128, 319, 320, 511, 512, 639};
    std::printf("column identity row0 C[0][n] (got vs %u*(n+1)+0.5):\n", K);
    for (uint32_t si = 0; si < sizeof(sampleNs) / sizeof(sampleNs[0]); ++si) {
        const uint32_t n = sampleNs[si];
        if (n >= N) {
            continue;
        }
        const float got = outputCHost[n];
        const double exp = static_cast<double>(K) * static_cast<double>(n + 1) + 0.5;
        const double rel = std::fabs(static_cast<double>(got) - exp) / (exp + 1.0);
        std::printf("  n=%3u got=%12.1f exp=%12.1f %s\n", n, static_cast<double>(got), exp,
                    (rel <= relTol) ? "OK" : "DIFF");
    }

    // Tile-grid rel-bad counts (baseM x baseN tiles over M x N).
    const uint32_t bm = static_cast<uint32_t>(tiling.baseM);
    const uint32_t bn = static_cast<uint32_t>(tiling.baseN);
    const uint32_t tileRows = (M + bm - 1) / bm;
    const uint32_t tileCols = (N + bn - 1) / bn;
    uint32_t perfectTiles = 0;
    std::printf("tile-grid rel-bad counts (%u x %u tiles of %ux%u):\n", tileRows, tileCols, bm, bn);
    for (uint32_t mb = 0; mb < tileRows; ++mb) {
        for (uint32_t nb = 0; nb < tileCols; ++nb) {
            uint32_t tileBad = 0;
            const uint32_t mHi = ((mb + 1) * bm < M) ? (mb + 1) * bm : M;
            const uint32_t nHi = ((nb + 1) * bn < N) ? (nb + 1) * bn : N;
            for (uint32_t m = mb * bm; m < mHi; ++m) {
                for (uint32_t n = nb * bn; n < nHi; ++n) {
                    const double got = static_cast<double>(outputCHost[m * N + n]);
                    const double exp = static_cast<double>(golden[m * N + n]);
                    if (std::fabs(got - exp) / (std::fabs(exp) + 1.0) > relTol) {
                        ++tileBad;
                    }
                }
            }
            if (tileBad == 0) {
                ++perfectTiles;
            }
            std::printf("%s%6u", (nb == 0) ? "  " : "", tileBad);
        }
        std::printf("\n");
    }
    std::printf("  perfect (0-bad) tiles=%u/%u\n", perfectTiles, tileRows * tileCols);

    // Row0 content attribution across baseN tile boundaries: x=(got-0.5)/K equals the golden
    // column index+1 whose content the slot actually holds (only meaningful when row0 ok).
    const uint32_t bndCols[] = {0, 127, 128, 129, 255, 256, 257, 383, 384, 385, 511, 512, 513, 639};
    std::printf("row0 baseN-boundary attribution C[0][n]: x=(got-0.5)/K (row0 col n holds x-1):\n");
    for (size_t i = 0; i < sizeof(bndCols) / sizeof(bndCols[0]); ++i) {
        const uint32_t n = bndCols[i];
        if (n >= N) {
            continue;
        }
        const double got = static_cast<double>(outputCHost[n]);
        const double x = (got - 0.5) / static_cast<double>(K);
        const double expX = static_cast<double>(n + 1);
        const double rel = std::fabs(x - expX) / (expX + 1.0);
        std::printf("  n=%3u got=%12.1f x=%9.3f %s\n", n, got, x, (rel <= relTol) ? "OK row0 col n" : "DIFF");
    }
    std::printf("==================== end %s ====================\n\n", tag);
}

extern "C" __global__ __mix__(1, 2) void matmul_abs(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c,
    __gm__ uint8_t* __kfc_workspace__ workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    MatmulAbsKernel<half, half, float, float> op;
    op.Init(a, b, bias, c, tiling, &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &op.tiling);
    op.Process();
}

int32_t main(int32_t argc, char** argv)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();

    constexpr uint32_t M = 1024;
    constexpr uint32_t N = 640;
    constexpr uint32_t K = 256;
    constexpr size_t aFileSize = M * K * sizeof(aclFloat16);
    constexpr size_t bFileSize = K * N * sizeof(aclFloat16);
    constexpr size_t biasFileSize = N * sizeof(float);
    constexpr size_t cFileSize = M * N * sizeof(float);
    const size_t workspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());

    // Probe F (NC-F): (SetDim, numBlocks) sweep; kernel byte-identical across all modes.
    //   F1(1,1)     : single core covers whole M x N.
    //   F2(2,2)     : dim == grid; cores split per tiling slab (this shape: M halves of 512).
    //   base(2,1)   : the previously-run official config (dim=2 but 1 block), kept for reference.
    const uint32_t modeDims[] = {1, 2, 2};
    const uint32_t modeBlocks[] = {1, 2, 1};
    const char* modeTags[] = {"F1(1,1)", "F2(2,2)", "base(2,1)"};
    constexpr uint32_t numModes = 3;

    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    uint8_t* inputADevice = nullptr;
    uint8_t* inputBDevice = nullptr;
    uint8_t* inputBiasDevice = nullptr;
    uint8_t* outputCDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&inputADevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&inputBDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&inputBiasDevice), biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&outputCDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    if (workspaceSize > 0) {
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&workspaceDevice), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST));
    }

    // Probe D (NC): non-constant inputs to defeat the blind constant golden.
    // A[m][k] = m+1, B[k][n] = n+1 (fp16 exact <= 2048), bias 0.5, K=256:
    //   D[m][n] = |A*B + bias| = 256*(m+1)*(n+1) + 0.5  (positive => Abs is a no-op).
    std::vector<aclFloat16> inputAHost(M * K);
    std::vector<aclFloat16> inputBHost(K * N);
    for (uint32_t m = 0; m < M; ++m) {
        for (uint32_t k = 0; k < K; ++k) {
            inputAHost[m * K + k] = aclFloatToFloat16(static_cast<float>(m + 1));
        }
    }
    for (uint32_t k = 0; k < K; ++k) {
        for (uint32_t n = 0; n < N; ++n) {
            inputBHost[k * N + n] = aclFloatToFloat16(static_cast<float>(n + 1));
        }
    }
    std::vector<float> inputBiasHost(N, 0.5f);
    std::vector<float> outputCHost(M * N, 0.0f);
    std::vector<float> golden(M * N);
    for (uint32_t m = 0; m < M; ++m) {
        for (uint32_t n = 0; n < N; ++n) {
            golden[m * N + n] =
                static_cast<float>(K) * static_cast<float>(m + 1) * static_cast<float>(n + 1) + 0.5f;
        }
    }

    CHECK_ACL(aclrtMemcpy(inputADevice, aFileSize, inputAHost.data(), aFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(inputBDevice, bFileSize, inputBHost.data(), bFileSize, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(inputBiasDevice, biasFileSize, inputBiasHost.data(), biasFileSize,
                          ACL_MEMCPY_HOST_TO_DEVICE));
    // Per-mode run: regenerate tiling, zero C, launch, D2H, full report. Kernel stays the same;
    // only SetDim (tiling) and the launch grid differ. C is zeroed per mode so "not written"
    // (0) is distinguishable from "written wrong".
    for (uint32_t mi = 0; mi < numModes; ++mi) {
        const uint32_t dim = modeDims[mi];
        const uint32_t numBlocks = modeBlocks[mi];
        auto tiling = GenerateTiling(ascendcPlatform, static_cast<int32_t>(dim));
        char tag[96];
        std::snprintf(tag, sizeof(tag), "%s dim=%u nb=%u", modeTags[mi], dim, numBlocks);

        CHECK_ACL(aclrtMemsetAsync(outputCDevice, cFileSize, 0, cFileSize, stream));
        matmul_abs<<<numBlocks, 0, stream>>>(inputADevice, inputBDevice, inputBiasDevice, outputCDevice,
                                             workspaceDevice, tiling);
        CHECK_ACL(aclrtSynchronizeStream(stream));
        std::fill(outputCHost.begin(), outputCHost.end(), 0.0f);
        CHECK_ACL(aclrtMemcpy(outputCHost.data(), cFileSize, outputCDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));

        PrintFullReport(tag, tiling, outputCHost, golden, M, N, K, dim, numBlocks);
    }

    CHECK_ACL(aclrtFree(inputADevice));
    CHECK_ACL(aclrtFree(inputBDevice));
    CHECK_ACL(aclrtFree(inputBiasDevice));
    CHECK_ACL(aclrtFree(outputCDevice));
    if (workspaceDevice != nullptr) {
        CHECK_ACL(aclrtFree(workspaceDevice));
    }
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}

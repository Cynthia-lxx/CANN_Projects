// Probe D: DataCopy gap semantics direct measurement (independent of matmul).
//
// Question: with the matmul writeback paradigm
//   DataCopy(gm, ub, {blockCount, blockLen(=baseN*4/32), srcStride, dstStride})
// the strided (dstGap>0) copy produced surprising layouts in cube_probe, and
// dstGap/srcGap semantics were unknown.  This probe removes matmul from the
// picture:  a hand-filled UB tile (32 rows x 32 fp32, row r = 1000.0f + r) is
// copied to three independent zero-initialized GM regions:
//   R0: {32, 4, 0, 0}   (dstGap=0, continuous reference)
//   R1: {32, 4, 0, 4}   (dstGap=4 -> exactly the cube_probe main strided params)
//   R2: {32, 4, 4, 0}   (srcGap=4 -> UB-side row skipping)
// Host prints, per region, the "source row -> flat GM element offset" map.
// That map reveals the true gap formula (pitch = blockLen+gap blocks or not)
// and whether UB rows are read at 128B pitch, without any matmul involvement.
//
// Reference layout pattern (canonical vector kernel, queue style):
//   tutorials/ascendc_operator_development/02_AscendC_basic/src/add_custom.asc

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {
constexpr uint32_t UB_ROWS = 32;  // source tile rows
constexpr uint32_t UB_COLS = 32;  // fp32 per row (128B)
constexpr uint32_t REGION_FLOATS = 4096;  // zero-filled GM region per test copy
constexpr uint32_t REGION_BYTES = REGION_FLOATS * sizeof(float);
constexpr uint32_t TOTAL_REGIONS = 3;
}

class CopySemKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* out, TPipe* pipe)
    {
        gOut.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out),
                             TOTAL_REGIONS * REGION_FLOATS);
        pipe->InitBuffer(outQueue, 1, UB_ROWS * UB_COLS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<float> ubBuf = outQueue.AllocTensor<float>();
        // Row r gets a constant 1000.0f + r across its 32 elements.
        for (uint32_t r = 0; r < UB_ROWS; ++r) {
            AscendC::Duplicate(ubBuf[r * UB_COLS], static_cast<float>(1000.0f + r),
                               static_cast<int32_t>(UB_COLS));
        }
        outQueue.EnQue(ubBuf);
        ubBuf = outQueue.DeQue<float>();

        // R0: continuous reference (dstGap=0).
        AscendC::DataCopy(gOut[0], ubBuf,
                          AscendC::DataCopyParams{static_cast<uint16_t>(UB_ROWS),
                                                  static_cast<uint16_t>(UB_COLS * sizeof(float) / 32),
                                                  0, 0});
        // R1: dstGap=4 blocks (cube_probe main strided params).
        AscendC::DataCopy(gOut[1 * REGION_FLOATS], ubBuf,
                          AscendC::DataCopyParams{static_cast<uint16_t>(UB_ROWS),
                                                  static_cast<uint16_t>(UB_COLS * sizeof(float) / 32),
                                                  0, 4});
        // R2: srcGap=4 blocks (UB-side row skipping).
        AscendC::DataCopy(gOut[2 * REGION_FLOATS], ubBuf,
                          AscendC::DataCopyParams{static_cast<uint16_t>(UB_ROWS),
                                                  static_cast<uint16_t>(UB_COLS * sizeof(float) / 32),
                                                  4, 0});
        outQueue.FreeTensor(ubBuf);
    }

private:
    GlobalTensor<float> gOut;
    TQue<QuePosition::VECOUT, 1> outQueue;
};

__global__ __aicore__ void copy_sem_probe(GM_ADDR out)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    CopySemKernel op;
    op.Init(out, &pipe);
    op.Process();
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                         __code);                                                                       \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char** argv)
{
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    constexpr size_t totalBytes = TOTAL_REGIONS * REGION_BYTES;
    uint8_t* outDevice = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&outDevice), totalBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    // Zero the GM regions first so gap/unwritten area reads back clean 0.
    CHECK_ACL(aclrtMemsetAsync(outDevice, totalBytes, 0, totalBytes, stream));

    copy_sem_probe<<<1, nullptr, stream>>>(outDevice);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    std::vector<float> outHost(totalBytes / sizeof(float), 0.0f);
    CHECK_ACL(aclrtMemcpy(outHost.data(), totalBytes, outDevice, totalBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    // Parse each region: locate where every source row (constant 1000+r) landed
    // as a contiguous run of UB_COLS equal elements at an 8-elem (32B) boundary.
    const char* regionDesc[TOTAL_REGIONS] = {"dstGap=0 (continuous ref)", "dstGap=4 (cube main strided)",
                                             "srcGap=4"};
    for (uint32_t k = 0; k < TOTAL_REGIONS; ++k) {
        const uint32_t base = k * REGION_FLOATS;
        std::vector<std::pair<uint32_t, uint32_t>> rowMap;  // (flatStartIdx, srcRow)
        for (uint32_t r = 0; r < UB_ROWS; ++r) {
            const float want = 1000.0f + static_cast<float>(r);
            for (uint32_t s = 0; s + UB_COLS <= REGION_FLOATS; ++s) {
                if ((s & 7u) != 0) {
                    continue;  // 32B boundary only
                }
                bool hit = true;
                for (uint32_t j = 0; j < UB_COLS; ++j) {
                    if (outHost[base + s + j] != want) {
                        hit = false;
                        break;
                    }
                }
                if (hit) {
                    rowMap.push_back(std::make_pair(s, r));
                    break;
                }
            }
        }
        std::sort(rowMap.begin(), rowMap.end());
        std::printf("R%u (%s): found %zu/32 source rows\n", k, regionDesc[k], rowMap.size());
        for (size_t i = 0; i < rowMap.size(); ++i) {
            std::printf("%s%u@%u", (i % 8 == 0) ? "  " : " ", rowMap[i].second, rowMap[i].first);
            if (i % 8 == 7 || i + 1 == rowMap.size()) {
                std::printf("\n");
            }
        }
        // Pitch analysis between consecutive found dst rows.
        uint32_t prev = 0;
        bool first = true;
        std::vector<uint32_t> pitches;
        for (size_t i = 0; i < rowMap.size(); ++i) {
            if (first) {
                prev = rowMap[i].first;
                first = false;
                continue;
            }
            pitches.push_back(rowMap[i].first - prev);
            prev = rowMap[i].first;
        }
        if (!pitches.empty()) {
            bool uniform = true;
            for (size_t i = 1; i < pitches.size(); ++i) {
                if (pitches[i] != pitches[0]) {
                    uniform = false;
                    break;
                }
            }
            std::printf("  dst pitch = %s%u floats (128B-block units: %u)\n", uniform ? "" : "NOT uniform, first ",
                        pitches[0], pitches[0] / 8u);
        }
        // Count unexpected non-zero elements (e.g. cross-row garbage reads).
        size_t unexpected = 0;
        for (uint32_t i = 0; i < REGION_FLOATS; ++i) {
            const float v = outHost[base + i];
            if (v != 0.0f && (v < 1000.0f || v > 1031.0f)) {
                ++unexpected;
            }
        }
        std::printf("  unexpected nonzero elements=%zu (garbage reads / cross-row mixes)\n", unexpected);
    }

    CHECK_ACL(aclrtFree(outDevice));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}
